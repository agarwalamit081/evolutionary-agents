# ─── LANGSMITH ─────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# ─── LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=deepseek          # deepseek | zai | ollama
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-ant-xxx
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# For cheap/fast sub-agent LLM (optional - falls back to main LLM)
FAST_LLM_PROVIDER=zai
FAST_LLM_MODEL=glm-4.5
FAST_LLM_API_KEY=sk-ant-xxx

OPENAI_API_KEY=sk-proj-
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=sk-
MISTRAL_API_KEY=
MISTRAL_ORG_ID=
DEEPSEEK_API_KEY=sk-
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
DASHSCOPE_API_KEY=  # Alibaba Qwen
ALIBABA_WORKSPACE_ID=
OPENROUTER_API_KEY=sk-

# ─── Memory ─────────────────────────────────────────────────────
MEMORY_DIR=./agent_memory        # SQLite + ChromaDB stored here
MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2   # local sentence-transformers model

# ─── Agent ─────────────────────────────────────────────────────
AGENT_ID=turing_001
AGENT_MAX_ITERATIONS=30
AGENT_MAX_RETRIES=3
AGENT_VERBOSE=true

# ─── Evolution ─────────────────────────────────────────────────
EVOLUTION_ENABLED=true
EVOLUTION_MODULES_DIR=./evolved_skills
EVOLUTION_MAX_DEPTH=10
EVOLUTION_REQUIRE_TESTS=true

# ─── Sub-agents ─────────────────────────────────────────────────
MAX_SUBAGENTS=5
SUBAGENT_MAX_ITERATIONS=10
