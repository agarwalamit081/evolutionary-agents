# Turing Agent — environment template.
#
# Copy to .env and fill in values:
#   cp env.example .env
# Owners maintaining the committed .env.example may also: cp env.example .env.example
#
# Data stack (docker compose): PostgreSQL 18 (pgvector) on host port 5433, Redis 7
# on host port 6380. The DATABASE_URL / REDIS_URL below point at those ports. The
# non-default host ports avoid clashing with a host-local Postgres/Redis other
# apps may own on 5432/6379.

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider API Keys
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT models, embeddings)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# DeepSeek
DEEPSEEK_API_KEY=

# Zhipu AI / GLM models
ZAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_ORG_ID=

# Moonshot / Kimi
MOONSHOT_API_KEY=

# Alibaba DashScope / Qwen
# DashScope keys are region-bound. The gateway defaults to the INTERNATIONAL
# (Bailian) OpenAI-compatible endpoint, so an intl key needs no override.
# Set ALIBABA_API_BASE ONLY for a China-region key:
# ALIBABA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=

# OpenRouter
OPENROUTER_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# NVIDIA
NVIDIA_API_KEY=nvapi-
# Explicit NVIDIA NIM endpoint. Registered nvidia model_ids are rewritten to the
# openai/ shim against this base (litellm rejects the bare nvidia/ prefix here).
# Leave EMPTY to use the public NIM endpoint baked into the shim
# (src/llm/nvidia_shim.py::NVIDIA_API_BASE = https://integrate.api.nvidia.com/v1);
# set this only to point at a private/regional NIM instance.
NVIDIA_API_BASE=

# ═══════════════════════════════════════════════════════════════════════════════
# SEARCH Stack (Phase 1): SearXNG primary + Meilisearch corpus + paid fallback
# ═══════════════════════════════════════════════════════════════════════════════
# SearXNG is the primary keyless live-search service; Meilisearch is the corpus
# keyword/hybrid index. Both listen on their canonical ports INSIDE the
# container (SearXNG 8080, Meilisearch 7700); docker-compose maps them to
# non-default HOST ports (8081 / 7701) so this stack never clashes with
# SearXNG/Meilisearch containers other projects may run on the defaults. The
# lightweight paid providers below are tried IN ORDER as automatic fallback when
# SearXNG fails/throttles (each used only if its key is set). Heavy providers
# (Firecrawl/Apify) are PROVISIONED-ONLY — they stay off unless
# DEEP_CRAWL_ENABLED=true.
#
# Primary + corpus service endpoints. Host-run values point at the mapped host
# ports (8081/7701); compose overrides these to the in-container hostnames
# http://searxng:8080 and http://meilisearch:7700 for the agent container.
SEARCH_PRIMARY=searxng
SEARXNG_URL=http://localhost:8081
SEARXNG_TIMEOUT=10
SEARXNG_MAX_RESULTS_PER_QUERY=10
MEILISEARCH_URL=http://localhost:7701
# Meilisearch master key. Leave EMPTY for keyless dev (MEILI_ENV=development runs
# without auth, which an empty key here matches). For production set a key of at
# least 16 bytes — the SAME value must be used by the agent (here) and by the
# compose service (docker-compose.yml MEILI_MASTER_KEY reads this var).
MEILISEARCH_KEY=
MEILISEARCH_INDEX=turing_corpus
MEILISEARCH_TIMEOUT=10
# Meilisearch indexes documents asynchronously: POST /documents returns a taskUid
# whose completion is polled (GET /tasks/{uid}) so an index-then-search in the
# same coroutine sees the docs (S11). interval: poll cadence; max_polls: cap
# (~3s @ 0.1s×30) after which we proceed — search may lag one beat.
MEILISEARCH_TASK_POLL_INTERVAL=0.1
MEILISEARCH_TASK_MAX_POLLS=30

# Comma-separated lightweight providers tried after SearXNG (in order).
SEARCH_FALLBACK_PROVIDERS=tavily,serper,brave,serpapi,serpstack,llmlayer

# Batch/parallel fan-out for web_search(queries) + corpus_search(queries).
SEARCH_BATCH_CONCURRENCY=5

# AI-format extraction/chunking (web_scraper -> corpus index).
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Heavy providers (Firecrawl/Apify): provisioned below but OFF by default.
DEEP_CRAWL_ENABLED=false

# ── Lightweight paid fallback provider keys (auto-fallback, optional) ──
TAVILY_API_KEY=
# Tavily adapter tuning (S12). Tavily returns a per-hit relevance score (0..1);
# these shape its request + result filter. Defaults keep the cheap/broad path.
#   search_depth: basic (cheaper) | advanced (higher quality, more credits)
#   topic: general | news  (days is only sent when topic=news)
#   include/exclude_domains: comma-separated hostnames, e.g. "arxiv.org,ncbi.nlm.nih.gov"
#   min_score: drop hits with score below this (0.0 = keep all)
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_DAYS=3
TAVILY_INCLUDE_DOMAINS=
TAVILY_EXCLUDE_DOMAINS=
TAVILY_MIN_SCORE=0.0
SERPER_API_KEY=
SERPAPI_API_KEY=
LLMLAYER_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPSTACK_API_KEY=

# ── Heavy providers (provisioned-only; need DEEP_CRAWL_ENABLED=true to engage) ──
APIFY_API_KEY=
FIRECRAWL_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Default Model Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash

FAST_LLM_PROVIDER=openai
FAST_LLM_MODEL=gpt-4o-mini-2024-07-18

# Z.AI GLM-4.7 (Moderate, 128K ctx, Text+Image) is the reasoning model. Swapped
# from claude-sonnet-4-6 (Anthropic) after that key hit an account usage cap
# (blocked until 2026-07-01). glm-4.7 is the registered MODERATE-tier Z.AI peer
# to Sonnet; verified live (zai/glm-4.7). Sonnet stays registered as a deep
# fallback — re-promote once the Anthropic quota resets.
REASONING_LLM_PROVIDER=zai
REASONING_LLM_MODEL=glm-4.7
# REASONING_LLM_PROVIDER=anthropic
# REASONING_LLM_MODEL=claude-sonnet-4-6

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Resilience, Circuit Breaker & Rate Limiting
# Operator-tunable knobs for the litellm gateway: retry/backoff, default sampling
# temperature + max_tokens (used when a call site omits them), the per-provider
# circuit breaker, and the default per-provider RPM/TPM token buckets.
# ═══════════════════════════════════════════════════════════════════════════════

LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0
LLM_RETRY_JITTER=2.0
LLM_DEFAULT_TEMPERATURE=0.5
LLM_DEFAULT_MAX_TOKENS=4096
# litellm's OWN internal retries. litellm defaults num_retries=3 internally, which
# layered UNDER our tenacity layer silently triples every transient-error HTTP hit
# (one logical call → up to 9 provider hits = 3 litellm × 3 tenacity). A single 429
# then fans into ~9 immediate re-hits that the provider correctly rate-limits, which
# our retries hit even harder — the root cause of the recurring "Z.AI degradation".
# 0 makes tenacity the SINGLE retry authority (it already backs off with jitter).
# Applies to every provider (GLM is hosted on zai/nvidia/... alike).
LLM_LITELLM_NUM_RETRIES=0
# Hard cap on the DEFAULT max_tokens (when a call site omits it). Without this the
# gateway falls back to the model's max_output (128000 for glm-4.7) on every
# classify/plan/verify/codegen call — reserving that whole budget in the rate
# limiter's TPM accounting and inflating provider rate-limit pressure for no benefit.
# 16K covers any realistic single response; callers needing more pass max_tokens.
LLM_MAX_OUTPUT_CAP=16384
# Per-node output-token caps (Phase 3.5 A3, rec #11). No call site passed
# max_tokens before, so every classify/plan/verify/reflect call reserved the
# full 16K cap (and verify AVERAGED ~3.3K OUTPUT tokens against a 4K default).
# These knobs cap each node's OUTPUT budget to what it actually needs, saving
# ~180K tokens/run (verify is a pass/fail gate — it needs no 4K prose). 0 = use
# LLM_MAX_OUTPUT_CAP (no per-node override). See gateway._node_max_tokens.
LLM_CLASSIFY_MAX_TOKENS=256
LLM_PLAN_MAX_TOKENS=2048
LLM_REFLECT_MAX_TOKENS=1024
LLM_VERIFY_MAX_TOKENS=512

# #1b — opt-in tool_choice="required" intermediate fallback. When a non-DeepSeek
# model rejects a forced-FUNCTION tool_choice (400), retry once with
# tool_choice="required" (call ANY tool) before dropping it. glm-4.7 rejects
# forced but accepts "required"; DeepSeek is excluded (thinking-mode conflict,
# handled by the thinking-disable path). OFF = today's drop-on-conflict behavior.
TOOL_CHOICE_FORCE_HARDENING=false

# Per-call LLM timeout (seconds) passed to litellm. Without it litellm defaults to
# ~600s, so one unresponsive provider stalls the whole run. Bounded by LLM_MAX_RETRIES:
# worst case ≈ timeout × retries before the fallback chain takes over.
REQUEST_TIMEOUT=90
# Longer timeout for code-generation calls (tool_create + evolution CODE mutations)
# that emit a full handler in one shot — these legitimately exceed REQUEST_TIMEOUT
# (observed live: a 58s deepseek-v4-pro codegen call cut at the old 60s default).
# Passed via a per-call override so reasoning/embedding calls keep REQUEST_TIMEOUT.
CODEGEN_TIMEOUT=180
# B1 — master wall-clock cap over the WHOLE per-call fallback chain (every model
# × every attempt for one logical call). A slow primary that times out can no
# longer amplify across the fallback chain into a multi-minute stall that trips
# the run-timeout watchdog: B1a stops same-model timeout retries, and this cap
# bounds the remaining chain to `master + one timeout`. Distinct from
# REQUEST_TIMEOUT (the per-CALL bound); this is the per-CHAIN bound. 0 = disabled.
LLM_REQUEST_TOTAL_TIMEOUT=300

# Tuned down from 5: rate-limit storms spread transient failures across providers,
# so 5-on-one rarely accumulates and the breaker's OPEN path never engaged.
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=60.0
CB_HALF_OPEN_MAX_CALLS=1

# Latency demotion gate — complement to the breaker: the breaker skips DOWN
# providers; this skips providers that are persistently SLOW on success (a
# 200-280s/call fallback that never trips an outage signal). Demotion is
# EWMA-based + cooldown-bounded (self-healing). Default-off (opt-in).
LATENCY_GATE_ENABLED=false
LATENCY_GATE_THRESHOLD_MS=150000
LATENCY_GATE_MIN_SAMPLES=3
LATENCY_GATE_COOLDOWN_S=120.0
LATENCY_GATE_ALPHA=0.5

RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_DEFAULT_TPM=100000
# When true AND a Redis client is attached, the per-provider RPM/TPM budget is
# enforced CROSS-PROCESS via an atomic Redis token-bucket so concurrent workers +
# sub-agents share ONE budget per provider. Without it the in-memory bucket is
# per-LLMGateway-instance (per-run), so two workers each get their own 60-RPM zai
# bucket = 120 RPM against a 60-RPM provider — the trigger of the "Z.AI
# degradation". Keyed off provider name, so it covers GLM on any hosting.
RATE_LIMIT_CROSS_PROCESS_ENABLED=true
# Max blocking acquire attempts (with backoff) before proceeding best-effort.
# Rate limiting is observability-only — it must never hard-fail a run.
RATE_LIMIT_MAX_WAIT_ATTEMPTS=5

# Operator overrides for the curated model tier maps (F2). These are read at
# route() CALL time by ModelRouter._apply_routing_overrides, layered ON TOP of
# the curated COMPLEXITY_TIER_MAP / NODE_TIER_MAP in src/llm/model_router.py.
# Each is a JSON object {routing_key: litellm_model_id}:
#   • node-tier key:     "<COMPLEXITY>:<node>"   e.g. "COMPLEX:execute"
#   • complexity-tier key: bare "<COMPLEXITY>"   e.g. "COMPLEX"
# A node-tier override wins over a complexity-tier override for the same
# decision. Empty (default) → the curated tables are used UNCHANGED. Invalid
# JSON or a model_id absent from MODEL_REGISTRY is ignored (logged) so a bad
# env can never break routing. The override's tier is re-derived from its
# ModelSpec. Only name models registered in src/config/model_registry.py.
ROUTING_NODE_TIER_OVERRIDES_JSON={}
ROUTING_COMPLEXITY_TIER_OVERRIDES_JSON={}
# Defensive default tier for an UNMAPPED TaskComplexity (the .get() fallback in
# route()/route_diverse()). EMPTY (default) -> the curated DEFAULT_COMPLEXITY_TIER
# in model_router.py (deepseek-v4-flash until the 2026-07-01 Anthropic revert,
# then claude-haiku-4-5-20251001). Set to a model_id in MODEL_REGISTRY to retune
# without a code change; an unknown id is ignored (curated default used).
ROUTING_DEFAULT_COMPLEXITY_TIER=
# Operator overlay for the curated FALLBACK_CHAINS (findings-06). A JSON object
# {model_id: [fallback, ...]} that is MERGED over the curated dict in
# src/config/model_registry.py: an overlay key REPLACES that model's chain; a
# new key is ADDED; untouched curated chains are preserved. Empty/invalid → the
# curated chains are used unchanged. Resolved + cached ONCE in ModelRouter init.
FALLBACK_CHAINS_JSON={}
# Providers excluded from ALL routing (primary/chain/diverse + gateway fallback
# pre-filter). AUTHORITATIVE when set (overrides the curated
# _TEMPORARY_DISABLED_PROVIDERS baseline): a comma-list (e.g. "anthropic" or
# "anthropic,minimax"). Default "anthropic" keeps the Anthropic key (under a
# quota cap) out of all routing this round; set to EMPTY (=) to re-enable
# anthropic once the cap resets. (Alias: ROUTING_DISABLED_PROVIDERS.)
DISABLED_PROVIDERS=anthropic

# Provider-native prompt caching (Anthropic cache_control). When enabled, a
# long system message sent to an Anthropic model is tagged with an ephemeral
# cache_control breakpoint so the reused system prompt is served from the
# provider cache on subsequent calls. Off by default → zero behavior change.
PROMPT_CACHE_CONTROL_ENABLED=false
PROMPT_CACHE_CONTROL_MIN_SYSTEM_TOKENS=1024

# Concurrent request batching for LLMGateway.abatch. Many independent
# completions run via asyncio.gather bounded by max_concurrency; the per-
# provider rate limiter still gates RPM/TPM under each call. Off by default →
# when disabled, abatch runs sequentially (concurrency 1).
LLM_BATCH_ENABLED=false
LLM_BATCH_MAX_CONCURRENCY=5

# Per-tier extended thinking/reasoning. When enabled, complex/critical tasks get
# provider-native thinking (Anthropic `thinking`, DeepSeek/Z.AI `extra_body`,
# OpenAI o-series `reasoning_effort`) and trivial/simple tasks get it off. Off
# by default → no thinking params emitted (zero behavior change). Anthropic
# requires temperature=1.0 with thinking; enforced automatically when enabled.
REASONING_CONTROL_ENABLED=false
REASONING_CONTROL_COMPLEX_THINKING=medium
REASONING_CONTROL_SIMPLE_THINKING=none
REASONING_CONTROL_ANTHROPIC_BUDGET_TOKENS_COMPLEX=8000
REASONING_CONTROL_ANTHROPIC_BUDGET_TOKENS_MEDIUM=4000

# Native JSON-schema structured outputs. When enabled, acompletion(response_schema=...)
# converts the JSON schema to a provider-native response_format (OpenAI/DeepSeek
# strict json_schema, Anthropic output_format, Gemini response_schema) so the
# model emits schema-conformant JSON natively. Off by default → response_schema
# is ignored (back-compat with prompt-based JSON + json_repair).
NATIVE_STRUCTURED_OUTPUT_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding Configuration
# EMBEDDING_DIM MUST match the pgvector Vector(N) columns (768).
# ═══════════════════════════════════════════════════════════════════════════════

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5433/turing_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6380/0
CACHE_TTL_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Token Budget Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Per-run cumulative token cap (raised 300K→500K: a complex multi-deliverable
# run with recompute/verification probes routinely spends 250-300K before
# converging, and the old cap fired BudgetExhaustedError just after the last
# write — killing the gateway mid-pass. See settings.py per_task_token_limit).
# Exhausting this cap hard-stops by default — see BUDGET_HARD_STOP below.
PER_TASK_TOKEN_LIMIT=500000
# Per-run USD cost cap (roadmap #1) — the $-complement to PER_TASK_TOKEN_LIMIT:
# bounds a single run's DOLLAR spend independent of the daily MAX_COST_USD pool,
# so one runaway run on an expensive model cannot drain the day. Attempt-relative
# (measures this attempt's run spend, baseline-captured at attempt start), so a
# resumed/re-enqueued run does not inherit its prior $ debt. 0 = DISABLED (opt-in
# safety bound); set e.g. 2.0 to cap each run at $2. See settings.py
# per_run_cost_limit.
PER_RUN_COST_LIMIT=0.0
# CUMULATIVE-ABSOLUTE per-run cost cap (two-tier backstop, Fix B). Unlike
# PER_RUN_COST_LIMIT (attempt-relative / baseline-subtracted), this measures the
# run's TOTAL $ spend across ALL attempts/redeliveries with NO baseline. It is
# the redelivery-forever backstop (battery q06): a run whose stream entry
# redelivered N× accumulated N× per-attempt spend unbounded. The terminal guard
# (Fix A1) skips a FINISHED run's duplicates, but an INCOMPLETE redelivery loop
# can still churn — this cap bounds that total. Set it ABOVE PER_RUN_COST_LIMIT
# (the per-attempt value) so it catches only genuine runaways, never a normal
# resume. 0 = DISABLED (opt-in). Example: PER_RUN_COST_LIMIT=1.0 +
# PER_RUN_COST_LIMIT_ABSOLUTE=3.0 caps each attempt at $1 AND the whole run at
# $3. See settings.py per_run_cost_limit_absolute.
PER_RUN_COST_LIMIT_ABSOLUTE=0.0
# CUMULATIVE-ABSOLUTE per-run TOKEN cap (Phase 3.5 A5, rec #10). The USD caps
# above do NOT bound a free/$0-model runaway — a $0 model never trips a $ cap.
# This token ceiling is the free-tier backstop: cumulative tokens across ALL
# attempts (no baseline, unlike PER_TASK_TOKEN_LIMIT's attempt-relative count).
# Mandatory if free-tier models are wired (Cluster B); 0 = DISABLED. See
# settings.py per_run_token_limit_absolute / CostTracker.check_budget tier 5.
PER_RUN_TOKEN_LIMIT_ABSOLUTE=0
MAX_COST_USD=10.0
BUDGET_WARN_THRESHOLD=0.70
BUDGET_CRITICAL_THRESHOLD=0.90
# Budget HARD-stop (battery-04 q09 fix D, P3). Default ON (terminal). When the
# per-run cap is exhausted, the gateway RAISES BudgetExhaustedError → the run
# stops and is marked BUDGET_EXHAUSTED (resumable via --resume). The old
# default (false) silently downgraded onto a cheaper/free-tier provider and
# KEPT GOING, which produced the observed token-burning cascade
# (soft-cap → free-tier fallback → repeated 429s → graph-level churn) instead
# of stopping. Set false only to deliberately allow degraded continuation.
BUDGET_HARD_STOP=true

# ═══════════════════════════════════════════════════════════════════════════════
# Evolution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

EVOLUTION_SANDBOX_TIMEOUT=30
EVOLUTION_SANDBOX_MEMORY_MB=256
EVOLUTION_SANDBOX_IMAGE=python:3.12-slim
# Mode for executing evolution-mutated code: docker | subprocess | runner.
#   docker     — isolated self-evolving-agent-toolbox container (needs a Docker socket).
#   runner     — remote no-DinD runner container over HTTP (Phase 3b/c: no
#                socket on the worker, no DB creds, no egress). The docker-compose
#                stack FORCES runner for the worker role (overrides this value).
#   subprocess — host subprocess fallback (no isolation).
EVOLUTION_SANDBOX_MODE=docker
EVOLUTION_SHADOW_REPO_PATH=.turing/evolution-repo
EVOLUTION_SOURCE_DIR=src
# Heuristic config-tuning mutation proposed temperature + max-tokens factor.
EVOLUTION_TEMPERATURE=0.4
EVOLUTION_MAX_TOKENS_FACTOR=0.9
# Phase 4 — A/B rigor: paired sandbox samples per arm (control then treatment).
# Each sample yields one duration diff for the Wilcoxon signed-rank test. 1
# reproduces the legacy single-sample heuristic (no statistical test); <=0 is
# clamped to 1. At small N promotion gates on the median/success-rate, not p<0.05.
AB_SAMPLE_SIZE=3
# Subprocess-sandbox venv-create / package-install timeouts (seconds) for the
# dynamic-tool codegen validation path.
SANDBOX_VENV_CREATE_TIMEOUT=60
SANDBOX_PACKAGE_INSTALL_TIMEOUT=120
# Phase 8 — evolution→live promotion gate (opt-in). When true, a deployed PROMPT
# mutation that passes the eval canary (>= EVAL_CANARY_MIN_SCORE) is written as a
# versioned artifact under EVOLVED_HANDLERS_DIR and a `current` pointer is updated
# so the live agent loads it via the prompt builder (tagged [evolved]). Scoped to
# PROMPT mutations (CODE/TOOL already reach live via the DB tool registry). Off by
# default — nothing promotes until the operator opts in.
EVOLUTION_PROMOTE_TO_LIVE=true
# Wall-clock budget (seconds) for the INLINE promotion canary, per battery goal.
# When promotion is on, the engine scores a deployed PROMPT mutation by running a
# full golden goal (default battery04_q01) SYNCHRONOUSLY inside the live run's
# evolve node, ON THE LIVE GATEWAY. A non-converging goal otherwise BLOCKS the
# live run until the worker wall-clock kills it (observed: a 30-min held-hostage
# run). A goal that cannot score within this budget is abandoned (no score → no
# promotion) and the live run proceeds; the canary's run_id is also scoped to its
# own bench- thread_id so its cost never bills to the live run. <= 0 disables the
# bound — an OFFLINE escape hatch only, never for live worker runs.
PROMOTION_CANARY_TIMEOUT_S=180
# Golden goal id(s) the INLINE promotion canary runs to score a candidate PROMPT
# mutation. Default battery04_q01,probe_format_fidelity — behavior (q01:
# normalization/UTC/dedup) PLUS format fidelity (probe_format_fidelity: CSV
# schema depth + a recomputed aggregate + a placeholder-leak-free report), so a
# mutation that degrades report format cannot pass the canary. Override with a
# goal that CONVERGES reliably under the active stack: a goal that cannot score
# within PROMOTION_CANARY_TIMEOUT_S makes the canary inconclusive on every evolve
# → channel-B prompt promotion NEVER fires (observed: q01 non-converges under
# glm-5.1 + Anthropic-disabled, looping 40 min). CSV (a,b) or JSON list; each id
# must resolve in GOLDEN_SPECS (battery04_q* + the LEARNING_PROBES); unresolvable
# ids are skipped. Unset = default.
# PROMOTION_CANARY_GOALS=battery04_q01,probe_format_fidelity
# Directory holding promoted, versioned handler artifacts (prompts first):
# <dir>/prompts/<node>.<sha>.json (immutable versions) + current.json (live
# pointer). Default under .turing/ (gitignored scratch), NOT in core src/.
EVOLVED_HANDLERS_DIR=.turing/evolved
# Phase 5 G2 — VCS-tracked promotion. A SECOND dir that mirrors only the
# immutable per-version artifact (<dir>/<node>.<sha>.json) into the VCS-tracked
# tree so a promotion lands in git (EVOLVED_HANDLERS_DIR above is gitignored).
# Default repo-root prompts/evolved/ (NOT under .turing/).
EVOLUTION_TRACKED_PROMPTS_DIR=prompts/evolved
# Phase 5 G2 — auto-commit the tracked artifact to the main repo on promotion
# (explicit-path git add, never -A; local-only, NEVER push). Separate opt-in on
# top of EVOLUTION_PROMOTE_TO_LIVE: off = tracked FILE still written (operator
# commits it); on = gate commits it. Best-effort/non-fatal.
EVOLUTION_PROMOTE_TO_VCS=false
# Phase 2 C1 — curve regression-guard on PROMPT promotion (default off). When
# true, the engine reads the nightly capability-curve verdict (see
# CAPABILITY_CURVE_*) BEFORE promoting and SKIPS a PROMPT promotion when the
# battery curve is regressed, so a mutation does not go live during a known
# capability-regression window. Only `regressed` blocks — `inconclusive`
# (cold-start / too few nightly points) is allowed through (the single-goal
# GoldenCanary still gates each mutation). Fail-open: a curve-read error never
# blocks promotion. Off by default = byte-identical to the ungated path.
EVOLUTION_REQUIRE_CURVE_CLEAR=false
# #8 / G1 — record a deployed CODE mutation as a SHADOW-ONLY promotion candidate
# (default off). When true, a CODE mutation that passed the engine's invariant +
# sandbox gates is written as a versioned candidate under evolved/code/ for review
# (PromotionGate.promote_code re-runs the invariant shadow-verification). The
# candidate NEVER reaches live core src/ — merge-to-live is intentionally deferred
# (the safe runner-based apply + live reload is future work), and GoldenCanary is
# not reused (it splices PROMPT suffixes into the live builder, which cannot
# exercise shadow-repo code). Off by default = byte-identical until toggled.
EVOLUTION_PROMOTE_CODE_TO_CORE=false

# ═══════════════════════════════════════════════════════════════════════════════
# Agent Execution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

MAX_ITERATIONS=60
# Complexity-aware runtime iteration cap (B1). When a run does NOT pin an
# explicit cap (no --max-iterations / worker max_iterations / eval spec), the
# routers + error_handler terminate at the tier cap for the classified goal
# complexity: a TRIVIAL goal stops loop-hunting early, COMPLEX/CRITICAL keep
# headroom. MAX_ITERATIONS above stays the recursion_limit BASIS and must be >=
# max(MAX_ITERATIONS_COMPLEX, MAX_ITERATIONS_CRITICAL) (validated at startup).
MAX_ITERATIONS_TRIVIAL=12
MAX_ITERATIONS_SIMPLE=15
MAX_ITERATIONS_COMPLEX=60
MAX_ITERATIONS_CRITICAL=60
# Convergence early-exit (B3): if verify produces an identical output
# fingerprint across this many consecutive passes AND the plan is exhausted,
# route_after_verify accepts the partial result via store_memory instead of
# looping to the iteration hard-cap (the run is "stably stuck"). Default 3:
# one transient repeat is common; three unchanged passes is a real plateau.
CONVERGENCE_STABLE_THRESHOLD=3
# C1 step-output memoization (default-off). When true, execute skips re-running a
# plan step whose description-hash already has a cached output — the cost saving
# on a re-plan (plan resets the step index to 0, so without this every completed
# step re-executes and re-bills). The cache is keyed on byte-identity over the
# step description (a rewritten step naturally misses) and cleared on a verify
# gap-replan. Opt-in because it is correctness-sensitive: validate in isolation
# (single q01, recomputation eval passes) before enabling for a battery curve.
STEP_MEMOIZATION_ENABLED=false
# Verify-cycle cap + oscillation (Phase 3.5 A4, recs #5/#15). A dedicated
# verify-cycle ceiling SEPARATE from MAX_ITERATIONS_*: route_after_verify accepts
# best-so-far (store_memory) once verify_cycle reaches VERIFY_MAX_CYCLES, so a
# stuck goal stops instead of looping 10-20 verify passes. Oscillation is
# sharper: if the same blocking-failure fingerprint repeats
# VERIFY_OSCILLATION_REPEAT consecutive times, abort early even below the cap.
VERIFY_MAX_CYCLES=12
VERIFY_OSCILLATION_REPEAT=3
# Routine-vs-final verify split (Phase 3.5 A6, rec #7). Only the LAST
# VERIFY_FINAL_LEAD verify passes keep the goal's real complexity (→ strong
# reasoning model); earlier routine passes demote to SIMPLE (→ cheap
# deepseek-v4-flash), saving ~180K tokens/run. Set >= VERIFY_MAX_CYCLES to keep
# the strong verifier on every pass (opt out of the demotion).
VERIFY_FINAL_LEAD=2
# Capability-cap gap-loop break (battery-04 q09 fix B). After this many
# consecutive cap-blocked spawn/create node-visits with no new capability
# (caps saturated), the routers stop re-routing into spawn/create and route to
# plan/verify instead, forcing convergence (resets to 0 on any real progress).
# Default 2 = one fully-saturated spawn+create cycle; live-validated on q09
# (3 needs 1.5 cycles, which a slow model never reaches inside the timeout).
CAP_LOOP_BREAK_THRESHOLD=2
MAX_TOOLS_PER_RUN=12
MAX_SUB_AGENTS_PER_RUN=5
# Execute-node concurrency + write-nudge loop, tool-gen regeneration attempts,
# and the verify-node data-tool ground-truth cap.
MAX_CONCURRENT_TOOLS=5
MAX_WRITE_NUDGES=2
TOOL_GEN_MAX_ATTEMPTS=3
VERIFY_MAX_DATA_TOOLS=8
# F2: bounded retry count for framework-mandated tool DB-persistence. Each
# attempt opens a fresh DB session so a transient connection error recovers.
TOOL_PERSIST_MAX_ATTEMPTS=2
# M4: per-tool success-metrics recording + performance retirement. Recording
# times every tool invocation and stores success/empty/latency (tool_call_metrics
# detail + running aggregates on tool_registrations). Non-fatal: a DB hiccup in
# the recorder never breaks a run. On load, chronic low performers are retired:
# calls >= RETIRE_MIN_RUNS and success_rate < RETIRE_SUCCESS_FLOOR. RETIRE_* also
# bound the over-cap path; MAX_ACTIVE_TOOLS is the hard population cap.
TOOL_METRICS_ENABLED=true
RETIRE_MIN_RUNS=20
RETIRE_SUCCESS_FLOOR=0.25
RETIRE_RECENCY_DAYS=30
# Phase-4 dead-weight retirement: distinct from the performance path above (which
# INTENTIONALLY spares untried tools). A generated tool with 0 calls whose
# created_at age exceeds RETIRE_UNUSED_DAYS is retired as dead weight no run ever
# selected — the periodic GovernancePruner (GOVERNANCE_PRUNE_ENABLED) runs it. The
# age gate is the safety: a freshly-spawned tool no run picked YET is NOT retired.
# Default 30 (mirrors RETIRE_RECENCY_DAYS); 0 disables the pass.
RETIRE_UNUSED_DAYS=30
# Low-call abandonware floor for the dead-weight pass above. The scan retires
# tools with calls <= RETIRE_UNUSED_MAX_CALLS (still gated by RETIRE_UNUSED_DAYS
# age). Default 3 retires tools tried a few times then abandoned — the cruft
# that saturates the 25-tool cap while dodging retire_redundant (distinct) and
# retire_underperforming (too few calls to score), so a freshly-generated
# capability can register instead of being skipped. (0 = "never invoked"-only.)
RETIRE_UNUSED_MAX_CALLS=3
# Phase-1c channel-A hardening (self-improvement battery). Fresh-tool
# protection: when > 0, ToolPersister.retire() SPARES any generated tool whose
# created_at is within this many seconds, so no governance pass can retire a
# prior run's tool before it is reused across generations. Insurance only —
# every pass already favors the newest tool; clean_state (the G0 reset) bypasses
# retire() and is unaffected. 0 disables (default). Battery sets 86400 (24h) via
# the docker-compose override; leave 0/unset in .env so host runs stay default.
TOOL_PROTECTION_WINDOW_S=0
# Phase-1c channel-A hardening (Layer 2). When true, execute_node locks
# tool_choice on turn 1 to a RECALLED (non-builtin) tool the step names verbatim,
# so reuse of a prior run's persisted capability is deterministic instead of left
# to the model's choice (which flipped to code_executor despite the tool being
# offered + top-1-recalled). Default off; the battery enables it via the
# docker-compose override. Leave false/unset in .env so host runs stay default.
REUSE_TOOL_CHOICE_HARDENING=false
# #11 — per-tool success contract. Some tools return a string on failure rather
# than raising (git_clone → "ERROR: ..."); without a contract that was recorded
# as success=True in tool_call_metrics, fooling governance retirement + the E2
# selection blend. When on, a tool's success_contract (sourced from
# TOOL_ANNOTATIONS) is evaluated against its output and the REAL outcome is
# recorded to metrics — WITHOUT mutating the model-facing ToolResult. A tool
# with no contract keeps today's behavior (non-raising ⇒ success). Fail-open:
# flag off / no contract / eval error ⇒ success. Default true.
TOOL_SUCCESS_CONTRACT_ENABLED=true
# #4 — mid-run capability-cap enforcement (default OFF). When on, tool_create /
# agent_spawn re-run the SAME nightly governance prune (retire redundant +
# underperforming + unused + over-cap) after a meaningful creation round,
# freeing DB-side headroom for the next creation. Cadence-bounded to once per
# MID_RUN_CAP_ENFORCE_INTERVAL iterations so a churny loop can't hammer the DB.
# The prune frees PERSISTED slots (future rounds + cross-run saturation); it
# does NOT evict the current run's already-loaded in-memory registry. Default
# off — load-time + nightly prune + the consecutive_cap_blocks loop-break
# already bound the worst case.
MID_RUN_CAP_ENFORCE_ENABLED=false
MID_RUN_CAP_ENFORCE_INTERVAL=10
# Tool retrieval-before-selection (findings-05; all default-off). When on, the
# execute/plan prompt gets the built-ins plus the top-K dynamically-created tools
# whose capability embeddings are nearest the goal — not EVERY active tool.
# Falls back to the full set when off, when no API embedding is available, or on
# any retrieval error, so behavior is unchanged until toggled on.
TOOL_RETRIEVAL_ENABLED=false
# Phase 3.5 A7 (rec #8): top-K lowered 8→5 to cut the tool-schema token share
# injected per execute call. The ~23 built-ins dominate, so trimming the
# dynamic set's marginal tail is free token savings.
TOOL_RETRIEVAL_TOP_K=5
# E2 — success-metric score-blend. When on, retrieval widens to a cosine pool
# (TOP_K × BLEND_POOL) then re-ranks by cosine·(1 + BLEND_WEIGHT·success_rate·
# (1−empty_output_rate)) before taking TOP_K, so a reliable slightly-less-similar
# tool can outrank a flaky near-match. Untested tools default to success_rate=1.0
# so they are never starved. weight=0 ⇒ pure cosine. Default-off.
TOOL_RETRIEVAL_BLEND_SUCCESS=false
TOOL_RETRIEVAL_BLEND_POOL=2
TOOL_RETRIEVAL_BLEND_WEIGHT=0.5
# F1 — semantic sub-agent selection before delegation fan-out (findings-05;
# default-off). When on, the SPAWNED agents are ranked by their stored
# capability embedding against the subtask and only the top AGENT_SELECTION_TOP_K
# run — the rest are pruned (agent_spawn already decided membership). Falls back
# to the full spawned set when off, when only one is spawned, when no API
# embedding is available, or on any recall error — so a needed agent is never
# dropped and tier-grouping/provider-spread is preserved among survivors.
AGENT_SELECTION_ENABLED=false
AGENT_SELECTION_TOP_K=3
# F3 — destructive-tool HITL gate (findings-05; default-off). When on, the
# execute node routes any tool flagged destructiveHint (terminal_command,
# http_request, index_corpus) through a LangGraph interrupt() approval
# checkpoint before invoking it. Approval resumes the call; rejection or a
# headless run with no resumer BLOCKS the tool (it does NOT run — the safe
# default for an irreversible op). file_writer (path-confined) and
# code_executor (runner-sandboxed) are NOT flagged destructive and never gate.
# A headless autonomous worker with this on will PAUSE on a destructive tool
# until resumed or the run timeout elapses — the op never runs unapproved.
DESTRUCTIVE_TOOL_HITL_ENABLED=false
# D2 — gateway multimodal/vision (findings-05; default-off). When on, a caller
# may pass `images=` to LLMGateway.acompletion; the gateway folds them into the
# last user message as OpenAI-format content blocks (text + image_url) and
# restricts the fallback chain to image-capable models (ModelSpec.supports_images,
# e.g. deepseek-v4-flash, gemini-2.5-flash, glm-4.7). Fail-safe: if no chain
# entry is vision-capable it attempts the original chain (provider may drop the
# images). Default off ⇒ all calls are text-only, byte-identical to today.
VISION_ENABLED=false
# Ambiguity-resolution cascade (Feature B; all default-off). When the master
# gate is on, classify flags an ambiguous goal (severity >= threshold) routes
# classify -> disambiguate -> plan. The disambiguate node runs a graduated
# ladder — LLM self-resolve -> web_search grounding -> LLM re-score -> HITL
# last resort — and carries the resolution forward as ADVISORY planner context
# (the literal goal is NEVER replaced; it stays the OBJECTIVE). With the gate
# off (default) route_after_classify always returns "plan" and the topology is
# byte-identical to today. Web grounding is on WITHIN the gate by default;
# HITL degrades to advisory (no Command(resume=) resume surface in worker/CLI
# today) rather than stalling the run.
CLARIFYING_GATE_ENABLED=false
CLARIFYING_SEVERITY_THRESHOLD=0.5
CLARIFYING_WEB_GROUNDING_ENABLED=true
CLARIFYING_MAX_QUERIES=3
CLARIFYING_HITL_THRESHOLD=0.7
CLARIFYING_HITL_ENABLED=false
# Per-step atomicity (Feature C; default-off). plan_quality is ALWAYS computed
# and attached as advisory telemetry (flags each step atomic / too_coarse /
# too_fine). When this gate is on, a too_coarse step (>=2 conjunctions) triggers
# ONE bounded heuristic conjunction-split (guarded so a reflect->plan loop can't
# re-split forever). Pure heuristic — zero LLM cost. Default off: plans pass
# through unchanged.
PLAN_ATOMICITY_ENFORCE=false
# Feature E: persist classify's refined_intent (Feature A) as a durable
# semantic fact (memory_type="fact") so later runs recall the real desired
# outcome behind a recurring goal. Best-effort + non-fatal. Default off.
PERSIST_INTENT_FACTS=false
# Multi-hop research loop (Phase 5a; default-off). When on, retrieve_memory ->
# research -> structure_analysis: a bounded retrieve→refine loop
# (web_search / corpus_search / arxiv_search) gathers advisory grounding before
# planning, accumulated into research_context. The literal goal is never
# rewritten. Off -> byte-identical to today (battery runs skip it entirely).
RESEARCH_LOOP_ENABLED=false
RESEARCH_MAX_HOPS=3
RESEARCH_TOP_K=3
RESEARCH_MAX_TOKENS=768
# E3: opt-in LLM-assist refinement for the structure_analysis node. When on AND
# the goal is COMPLEX/CRITICAL AND the deterministic regex pass found nothing, a
# one-shot gateway call (per configured routing) infers capability gaps the
# static patterns miss. Fail-safe: any LLM/parse error leaves the regex result
# unchanged. Default off -> regex-only (byte-identical behavior).
STRUCTURE_ANALYSIS_LLM_ASSIST_ENABLED=false
# Autonomous memory-folding LLM sampling temperature + output budget.
MEMORY_FOLDING_TEMPERATURE=0.1
MEMORY_FOLDING_MAX_TOKENS=2048
# Phase 5 semantic/fact memory tier. On each persisted fold the episode summary
# is mined for durable facts (entity-ish knowledge: schemas/counts/invariants)
# and stored as warm memory_type="fact" — distinct from skills and from episodic
# cold memory, recalled alongside skills. Extraction is best-effort (a gateway
# failure yields no facts, never an error). MEMORY_FACT_MAX_PER_FOLD bounds how
# many facts a single fold can emit.
MEMORY_FACT_EXTRACTION_ENABLED=true
MEMORY_FACT_MAX_PER_FOLD=5
# A4: how many recent hot-memory observations retrieve_context surfaces,
# newest-first (Redis ZSET recency index). Replaces the legacy unordered
# scan that hard-capped at 2.
MEMORY_HOT_RECALL_SIZE=3
# Phase 3 evaluation harness (correctness layer). EVAL_ENABLED gates the
# verify-node correctness checks; set true (or use `python main.py --eval`) to
# score Battery-04 goals. A run with no registered GoalSpec still gets a generic
# ad-hoc deliverable eval row (parsed/non-empty per file) when
# EVAL_ADHOC_DELIVERABLES=true — pure observability, never enforced.
# EVAL_ENFORCE (enabled here; code default false) downgrades a "complete"
# verdict to incomplete when a correctness check fails so the agent retries +
# self-corrects. The LLM
# judge (deepeval/ragas with a gateway fallback) and the durable eval_results
# store have their own toggles; EVAL_CANARY_MIN_SCORE gates oracle pass/fail.
EVAL_ENABLED=true
EVAL_ENFORCE=true
EVAL_LLM_JUDGE_ENABLED=true
EVAL_CANARY_MIN_SCORE=0.8
EVAL_STORE_ENABLED=true
# F-e: run correctness checks the first time deliverables appear on disk on an
# INCOMPLETE verify (not just at is_complete), folding failing-check reasons
# into the re-plan as advisory feedback. Bounded to one rescue per run.
EVAL_RESCUE_INCOMPLETE=true
# A run with NO battery GoalSpec still records a generic structural eval_results
# row (parse + non-empty per on-disk deliverable) so fresh/unspecced queries are
# evaluated too. Observability-only — never enforces (a parse hiccup must not
# loop a real run; verify's completion gate already enforces well-formedness).
EVAL_ADHOC_DELIVERABLES=true
# Model used to generate dynamic tool-handler code. Default deepseek-v4-pro is a
# code-strong, low-cost model with a full fallback chain — avoids the CHEAP-tier
# (complexity=SIMPLE → Haiku) truncation that sank non-trivial tools. Alt:
# gpt-4.1-mini-2025-04-14. Empty → fall back to complexity=SIMPLE routing.
TOOL_GENERATION_MODEL=deepseek-v4-pro
CONTEXT_WINDOW_RESERVE=0.15
HITL_ENABLED=true
WORKSPACE_ROOT=.turing/workspace
# Phase 7: per-run results subfolders. When true + a run_id active (set by
# --run-id), deliverables written via the shared path resolver land under
# results_root/<run_id>/... (isolating each run). Reads fall back to the flat
# results_root when the run subdir is empty, so older flat deliverables still
# recall. CLI flags --results-dir <path> and --clean also govern this. No-op
# without a run_id. RESULTS_ROOT itself defaults to "results".
RESULTS_ROOT=results
RESULTS_PER_RUN_SUBDIR=true

# ═══════════════════════════════════════════════════════════════════════════════
# Built-in Tool Limits (timeouts, size caps, retry params)
# Bound tool I/O. Read at call-time so .env changes take effect without a
# restart in long-running hosts.
# ═══════════════════════════════════════════════════════════════════════════════

# terminal_command
TERMINAL_COMMAND_TIMEOUT=30.0
TERMINAL_MAX_OUTPUT_BYTES=16000
# http_request
HTTP_REQUEST_TIMEOUT=15.0
HTTP_MAX_RESPONSE_CHARS=8000
HTTP_MAX_BODY_BYTES=1000000
# web_scraper
WEB_SCRAPER_TIMEOUT=20.0
WEB_SCRAPER_MAX_BYTES=5242880
WEB_SCRAPER_MAX_CHARS=8000
# ocr_parser (Z.AI glm-ocr layout_parsing API)
OCR_PARSER_TIMEOUT=30.0
OCR_PARSER_MAX_CHARS=8000
# image_generator (litellm aimage_generation). Separate API surface from chat.
# gpt-image-1 is a real litellm image-gen model (~$0.011/image at low/1024²).
# Swap IMAGE_GEN_MODEL for dashscope/qwen-image-2.0 to reuse the DASHSCOPE key.
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_DEFAULT_SIZE=1024x1024
IMAGE_GEN_DEFAULT_QUALITY=low
IMAGE_GEN_TIMEOUT=60.0
IMAGE_GEN_API_BASE=
# code_executor
CODE_EXECUTOR_TIMEOUT=30
# ── code_executor sandbox isolation (Phase 2c docker / Phase 3b/c runner) ──
#   subprocess — host subprocess (default; no isolation). The host-run default.
#   docker     — isolated self-evolving-agent-toolbox container (network off, read-only FS,
#                memory cap), results dir mounted RW. Needs a Docker socket +
#                `docker compose --profile sandbox build toolbox`. Falls back to
#                the host subprocess if Docker is unavailable.
#   runner     — remote no-DinD runner container over HTTP (Phase 3b/c: no socket
#                on the worker, no DB creds, no egress). The docker-compose stack
#                FORCES runner for the worker role (overrides this value); for a
#                host `python main.py` run, set MODE=runner + RUNNER_URL to a
#                runner you have started separately.
CODE_EXECUTOR_MODE=subprocess
# ── code_executor host-subprocess confinement (D8; subprocess mode only) ──
#   docker/runner modes are already sandbox-confined; these harden the HOST
#   fallback. When PATH_GUARD is on, the bootstrap-injected `open` rejects any
#   path resolving OUTSIDE the results/workspace tree — checked AFTER
#   relocation, so a script reads/writes its own deliverables + fixtures but
#   cannot reach repo-root secrets (`open(".env")`) or system files
#   (`open("/etc/hosts")`). Default OFF (behavior unchanged); host mode is
#   otherwise relative-confined / absolute-trusted.
CODE_EXECUTOR_HOST_PATH_GUARD=false
#   The host subprocess working directory. `project_root` (default) is the cwd
#   every other file-touching tool shares, so `glob('results/*.md')` resolves
#   uniformly — KEEP this default (`results_subdir` double-nests a `results/<file>`
#   write). `results_subdir` opts into cwd = the per-run results subfolder
#   (results_root fallback) for tighter disk isolation where a run's scripts use
#   bare names.
CODE_EXECUTOR_HOST_CWD=project_root
CODE_EXECUTOR_SANDBOX_IMAGE=self-evolving-agent-toolbox:latest
CODE_EXECUTOR_SANDBOX_MEMORY_MB=512
CODE_EXECUTOR_SANDBOX_TIMEOUT=60
CODE_EXECUTOR_RESULTS_MOUNT=
CODE_EXECUTOR_SANDBOX_WORKDIR_DEST=/workspace/results
# ── #2 generated-tool isolation default (worker-process) ──
# Without these, generated-tool isolation hinges SOLELY on CODE_EXECUTOR_MODE; a
# worker that runs in subprocess mode would run untrusted LLM handler code
# in-process (full DB/Redis/FS access). Set TURING_WORKER_PROCESS=1 in the
# worker/runner process so isolation engages by default even in subprocess mode,
# auto-promoting to the runner surface (fail-closed if down). The host CLI sets
# none of these, so it stays subprocess/in-process.
TURING_WORKER_PROCESS=false
ISOLATION_DEFAULT_TO_SANDBOX=true
AUTO_PROMOTE_SUBPROCESS_TO_RUNNER=true
# ── remote no-DinD runner client (Phase 3b/c) ──
# Where the worker POSTs code in runner mode. The compose stack sets this to
# http://runner:8090 (internal). For a host run, point it at a standalone runner.
# Connect/5xx/malformed errors raise SandboxUnavailable -> code_executor falls
# back to the host subprocess so a run never hard-fails on a down runner.
RUNNER_URL=http://runner:8090
RUNNER_CONNECT_TIMEOUT_S=5.0
RUNNER_MAX_TIMEOUT_S=300
# web_search (DuckDuckGo)
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_DELAY_MIN=0.2
WEB_SEARCH_DELAY_MAX=0.6

# ═══════════════════════════════════════════════════════════════════════════════
# Logging Configuration
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_DIR=./logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# ═══════════════════════════════════════════════════════════════════════════════
# Observability Configuration
# ═══════════════════════════════════════════════════════════════════════════════

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=turing-agent
OTEL_SAMPLING_RATE=0.10

# Prometheus /metrics scrape server (worker/scheduler/optimizer bind this port;
# the api exposes /metrics as a FastAPI route on its app port instead). Default
# 9100 — NOT 9090 (9090 is the Prometheus server's own port; exposing app
# metrics there clashes with the scraper). In the compose stack, the
# `observability` profile deploys Prometheus (scrapes api:8000 + worker:9100
# via dns_sd) + Grafana + Phoenix (OTLP traces). NOTE: compose FORCES
# PROMETHEUS_ENABLED=true on the app roles so the stack works out-of-the-box;
# OTEL_ENDPOINT is forced to http://phoenix:6006 so traces flow when OTEL_ENABLED
# is flipped on. Bring it up with: docker compose --profile observability up -d
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9100

# Record provider-native prompt-cache token counts (Anthropic cache read /
# creation) as Prometheus counters so cache hit-rate is measurable. No-op when
# PROMETHEUS is off or a response reports no cache tokens. (#13)
LLM_CACHE_TOKEN_METRICS_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# LangSmith Tracing Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# The app gates tracing SOLELY on LANGCHAIN_TRACING_V2: LangSmithSettings
# .is_configured = langchain_tracing_v2 AND api_key present (settings.py); LangGraph
# autodetects LANGCHAIN_TRACING_V2 for graph traces; gateway.py registers the litellm
# `langsmith` success/failure callbacks when LANGCHAIN_TRACING_V2 == "true". So to turn
# tracing ON, set LANGCHAIN_TRACING_V2=true + a valid LANGSMITH_API_KEY. To turn it OFF,
# set LANGCHAIN_TRACING_V2=false (the api path never checks the api key when off).
# LANGSMITH_TRACING (below) is the newer standalone-LangSmith-SDK flag and is NOT read
# by this app yet — it is inert; keep it consistent with LANGCHAIN_TRACING_V2 for
# coherence so the two flags don't silently contradict (as they did before).

LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=turing-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ═══════════════════════════════════════════════════════════════════════════════
# Environment Metadata
# ═══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
DEPLOYMENT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# Worker — Redis Streams queue seam (Phase 2b)
# ═══════════════════════════════════════════════════════════════════════════════

# The stateless API role enqueues run requests to a Redis Stream; worker
# processes consume them via a consumer group. At-least-once delivery: a worker
# XACKs only AFTER the run's checkpoint is durable, so a crash between claim and
# ack leaves the message pending for another worker to reclaim (XAUTOCLAIM) and
# resume from the last checkpoint (thread_id = api-{run_id} is stable). See
# src/worker/.

WORKER_RUNS_STREAM=turing:runs
WORKER_GROUP=turing-workers
# LEAVE UNSET for a replicated worker pool: each replica then auto-derives a
# UNIQUE consumer name (worker-<hostname>-<pid>) so replicas don't share a
# pending-entries list — XAUTOCLAIM crash-recovery stays sound at scale. Setting
# a fixed name here (e.g. worker-1) makes EVERY replica collide on that one name,
# silently breaking crash-recovery (the exact bug this default shipped for years).
# Set an explicit value ONLY for a single, fixed-name worker (debugging).
# WORKER_CONSUMER_NAME=worker-1
WORKER_READ_BATCH_SIZE=5
WORKER_BLOCK_MS=5000
WORKER_RECLAIM_MIN_IDLE_MS=30000
WORKER_STATUS_TTL_S=86400
# Dead-letter cap: after this many failed delivery attempts a run is acked +
# marked FAILED permanently (NOT redelivered). Stops infinite poison-message
# redelivery of a DETERMINISTIC failure (e.g. a missing dep crashing graph build)
# — XAUTOCLAIM would otherwise re-hand it to a worker every RECLAIM_MIN_IDLE_MS
# forever. Transient failures still retry up to this many times.
WORKER_DEAD_LETTER_MAX_ATTEMPTS=3
# Run-level wall-clock timeout (battery-04 q09 fix A). Default 0 = OFF. When >0
# the worker wraps execute_run in asyncio.timeout; on expiry the run is marked
# TIMEOUT + acked (terminal, not redelivered) and the checkpoint persists so it
# is resumable via `python main.py --resume <run_id>`. A per-run override is
# POST /run {run_timeout_s}. Bounds non-terminating cap-saturation loops.
# 7200 (2h) — a looser safety net: convergence is iteration-bound (MAX_ITERATIONS),
# so this only force-terminates genuinely stuck/slow runs; it rarely binds.
WORKER_RUN_TIMEOUT_S=7200

# ═══════════════════════════════════════════════════════════════════════════════
# Scheduler — nightly capability-curve battery feeder (#197 Phase 5)
# ═══════════════════════════════════════════════════════════════════════════════
#
# No run path is time-triggered today: runs enter turing:runs only via the API
# or the host CLI --eval, so the capability curve only updates when a human runs
# --eval. This sidecar (python -m src.scheduler) enqueues every BATTERY04_GOALS
# spec into turing:runs on SCHEDULER_CRON, so the worker runs the battery through
# the real deployed stack and eval_results populates the curve autonomously.
#
# Opt-in: SCHEDULER_ENABLED defaults false (a bare host run is a clean no-op).
# The docker-compose `scheduler` service is profile-gated AND forces it true.
# Bring it up with: docker compose --profile scheduler up -d
SCHEDULER_ENABLED=false
# 5-field crontab (APScheduler CronTrigger.from_crontab). Default: nightly 02:00.
SCHEDULER_CRON=0 2 * * *
# IANA timezone for the cron schedule.
SCHEDULER_TIMEZONE=UTC
# Optional pinned model for every battery run (registry key / litellm id). Empty
# -> each run uses its complexity-tiered default.
SCHEDULER_MODEL=
# Battery runs SHOULD exercise evolution (the richest learning signal). Set true
# only to disable evolution for a scheduled battery (debugging / baseline).
SCHEDULER_NO_EVOLUTION=false
# Smoke / partial-curve cap: 0 = enqueue EVERY spec (the production nightly curve);
# >0 = enqueue only the first N (set 1 for a cheap one-spec plumbing smoke that
# does not run the full battery).
SCHEDULER_SPEC_LIMIT=0
# strftime appended to each spec id as -<suffix> for per-night results isolation.
# Keep %Y%m%d (compact, no embedded hyphens): _resolve_eval_spec_id strips a
# trailing -YYYYMMDD (8 digits) to recover the spec id for eval scoring.
SCHEDULER_DATE_SUFFIX_FORMAT=%Y%m%d
# Cross-query DAG-release (#575): the battery-04 goals are a dependency graph
# (q02/q03←q01, q06←q05, q04←q1-q3), not 9 independent queries. Roots enqueue
# immediately; a dependent is held until its upstream reaches a terminal status.
# release_poll_s = how often to re-check upstream status (default 30s).
# release_wait_s = overall deadline before enqueuing remaining dependents
#   anyway (default 4h — under the 24h status-hash TTL; a missing upstream →
#   honest low score). Battery jobs also set RESULTS_PER_RUN_SUBDIR=false and
#   self-clear their own results/<qNN>/ dir pre-run so flat cross-query reads
#   resolve to the upstream's real output, not a stale cross-night file.
SCHEDULER_RELEASE_POLL_S=30
SCHEDULER_RELEASE_WAIT_S=14400

# ──────────────────────────────────────────────────────────────────────
# Capability-curve trend + regression→rollback gate (Phase 2 C1).
# The nightly battery collects per-check correctness scores over time in
# eval_results; this gate watches the battery TREND across nights and reverts
# a PROMPT promotion whose benefit did not hold (the single-goal canary only
# gates at promotion time). Regression = current < SCORE_FLOOR AND
# (best_prior - current) >= REGRESSION_DELTA AND >= MIN_POINTS nights. Detection
# is always-on + read-only; AUTO_ROLLBACK is the human's opt-in to automatic
# reversion (default off, like the scheduler). The gate job defaults to 05:00
# UTC (after the 02:00 battery). See src/eval/curve.py + src/evolution/curve_gate.py.
CAPABILITY_CURVE_GATE_ENABLED=false
CAPABILITY_CURVE_CURVE_CRON=0 5 * * *
CAPABILITY_CURVE_TIMEZONE=UTC
CAPABILITY_CURVE_REGRESSION_DELTA=0.1
CAPABILITY_CURVE_SCORE_FLOOR=0.5
CAPABILITY_CURVE_LOOKBACK_DAYS=30
CAPABILITY_CURVE_MIN_POINTS=2
CAPABILITY_CURVE_AUTO_ROLLBACK=false

# ═══════════════════════════════════════════════════════════════════════════════
# Periodic capability-governance prune (battery-04 q09 fix C)
# ═══════════════════════════════════════════════════════════════════════════════
# A long-lived worker accumulates the active tool/sub-agent population across
# runs and never prunes until restart (q09 saturated 25/25 tools, 60/60
# sub-agents mid-life). When enabled, the scheduler re-runs the existing
# consolidate.py retire/redundancy passes on GOVERNANCE_PRUNE_CRON, freeing cap
# headroom WITHOUT raising the caps. Reuses AgentSettings retire knobs. Opt-in.
GOVERNANCE_PRUNE_ENABLED=false
GOVERNANCE_PRUNE_CRON=0 4 * * *
GOVERNANCE_PRUNE_TIMEZONE=UTC

# ═══════════════════════════════════════════════════════════════════════════════
# Periodic checkpoint garbage-collection (battery-04 q101 / Phase 6a)
# ═══════════════════════════════════════════════════════════════════════════════
# langgraph's AsyncPostgresSaver writes one row per graph step into checkpoints /
# checkpoint_writes / checkpoint_blobs and NEVER expires them — a long-lived
# worker accumulates unbounded checkpoint state. When enabled, the scheduler drops
# WHOLE threads whose newest checkpoint is older than CHECKPOINT_GC_TTL_DAYS (runs
# are bounded to minutes–hours by the cost/iteration caps, so an untouched thread
# is definitively finished). checkpoint_id is a time-ordered UUIDv6 that parses
# back to a Unix timestamp — no migration, deletes on existing tables. Opt-in AND
# dry-run default: logs candidate threads + counts and deletes NOTHING until
# CHECKPOINT_GC_DRY_RUN is flipped false after reviewing a log. Registered in the
# `scheduler` profile service (src/scheduler/__main__.py). Default cron 06:00 UTC —
# clear of the 02:00 battery / 03:30 optimizer / 04:00 prune / 05:00 curve-gate.
CHECKPOINT_GC_ENABLED=false
CHECKPOINT_GC_CRON=0 6 * * *
CHECKPOINT_GC_TIMEZONE=UTC
CHECKPOINT_GC_TTL_DAYS=7
CHECKPOINT_GC_DRY_RUN=true

# ═══════════════════════════════════════════════════════════════════════════════
# Metric-driven prompt optimizer sidecar (Phase 2 C2: DSPy + GEPA)
# ═══════════════════════════════════════════════════════════════════════════════
# A nightly, cost-bounded job that runs DSPy/GEPA against the golden canary and
# — IF a candidate prompt beats the baseline correctness score by the margin AND
# C1's capability-curve regression gate is clear — pushes it through the EXISTING
# PromotionGate (canary-gated, auto-rollback). Beyond the engine's one-shot LLM
# PROMPT mutation: a real metric-driven SEARCH over prompt instructions.
#
# Runs in its OWN container (`self-evolving-agent-optimizer`, profile-gated) so
# the DSPy+GEPA ML deps stay out of the slim api/worker images. DSPy declares NO
# torch dependency (`import dspy` is torch-free; verified dspy==3.2.1). The
# sidecar imports src/, runs its own LLMGateway against the shared cost_ledger
# (cost/budget/circuit-breaker work natively), and spend lands under run_id
# `optimizer-<node>-<ts>` — bounded by OPTIMIZER_MAX_COST_USD.
#
# Architecture (GEPA's real API): GEPA optimizes a DSPy module's instruction by
# running it (1 LLM call) and scoring — it can't run the full agent graph in its
# loop. So GEPA searches candidates against a CHEAP PROXY metric (bounds cost);
# the optimized instruction is then VALIDATED against the REAL GoldenCanary
# correctness score (full agent runs) before promotion. The eval metric stays the
# promotion gate (DoD satisfied); GEPA supplies the search; C1 backstops the
# proxy→canary transfer risk.
#
# PRECONDITION: only enable once C1's regression gate (CAPABILITY_CURVE_*) is
# proven. Every knob defaults OFF. No DB migration (reuses eval_results +
# cost_ledger + .turing/evolved/prompts/).
OPTIMIZER_ENABLED=false
# BOUNDED SMOKE RUN (replaces the deleted throwaway docker-compose.override.yml):
# set OPTIMIZER_ENABLED=true + OPTIMIZER_EVAL_SPEC_LIMIT=1 + OPTIMIZER_MAX_CANDIDATES=2
# here in .env, then `docker compose --profile optimizer --profile scheduler up -d`.
# OPTIMIZER_MAX_COST_USD (below) caps each run's spend at $0.50.
OPTIMIZER_BACKEND=dspy-mipro             # dspy-mipro | dspy-copro | dspy-gepa (deferred)
OPTIMIZER_TARGET_NODE=classify           # v1 ships the classify profile; execute/verify are pluggable-but-unshipped
OPTIMIZER_EVAL_SPEC_LIMIT=2              # golden specs the FINAL canary validates against (cheapest=1)
OPTIMIZER_MAX_CANDIDATES=8               # MIPROv2/COPRO breadth (GEPA budget is max_trials)
OPTIMIZER_MAX_TRIALS=1                   # GEPA full-eval rounds (0 → auto="light")
OPTIMIZER_MAX_TOKENS=1024                # DSPy student + reflection LM max output tokens
OPTIMIZER_TEMPERATURE=0.7                # LM sampling temperature
# OPTIMIZER_REFLECTION_MODEL — leave BLANK to auto-route a COMPLEX-tier model (e.g. glm-4.7);
# or set a literal model id to pin the reflection/proposal LM (GEPA reflection_lm / MIPROv2·COPRO prompt_model).
# NOTE: pydantic-settings does NOT strip inline comments, so this value MUST stay empty (no trailing "# ...").
OPTIMIZER_REFLECTION_MODEL=
OPTIMIZER_CRON="30 3 * * *"              # 03:30 UTC — between 02:00 battery and 05:00 curve-gate
OPTIMIZER_TIMEZONE=UTC
OPTIMIZER_HOST=0.0.0.0                     # aiohttp bind (internal-only on turing-net; no host port is published)
OPTIMIZER_PORT=8095                        # the sidecar's own listen port (scheduler connects via OPTIMIZER_URL)
OPTIMIZER_URL=http://optimizer:8095        # client-side connect URL the scheduler POSTs /optimize to (compose service name)
OPTIMIZER_REQUIRE_CURVE_CLEAR=true       # refuse while curve regressed/inconclusive (C1 precondition)
# OPTIMIZER_CANARY_MIN_SCORE=0.0         # uncomment + set the required (candidate−baseline) margin; blank → reuse EVAL_CANARY_MIN_SCORE as the floor
OPTIMIZER_MAX_COST_USD=0.50              # hard spend cap per optimization run (US$)

# ── Agent-settable durable cron (Phase 5 I1; default OFF) ──────────────
# Lets the AGENT schedule its own future work via the create_scheduled_task
# builtin: a durable scheduled_tasks row the scheduler consumer fires into the
# turing:runs stream on a cron. The tool no-ops and the consumer arms nothing
# until AGENT_CRON_ENABLED=true, so a host run is byte-identical to pre-I1.
# PRECONDITION: also needs SCHEDULER_ENABLED=true (the consumer registers on the
# scheduler daemon) — enable BOTH + bring up the scheduler service to opt in.
AGENT_CRON_ENABLED=false
AGENT_CRON_MAX_TASKS=25                  # cap on ENABLED rows (cron-abuse guard; re-calling an existing name UPSERTs, not a new slot)
AGENT_CRON_MAX_GOAL_CHARS=2000           # max length of the stored goal / enqueued RunJob.goal
AGENT_CRON_SYNC_INTERVAL_S=60            # how often (s) the consumer reconciles rows ↔ APScheduler jobs
AGENT_CRON_TIMEZONE=UTC                  # reconcile IntervalTrigger tz (per-task cron uses each row's own timezone, default UTC)

# ── Git-clone code indexer (Phase 5 I2; default OFF) ───────────────────
# Lets the AGENT git_clone a PUBLIC repo into a confined workspace subdir and
# index its source into pgvector cold memory (episode_type="code") so a later
# code_search recalls symbols by semantic similarity — the agent's "codebase
# memory" for repos it has read. The tool no-ops until GIT_CLONE_ENABLED=true,
# so a host run is byte-identical to pre-I2. The caps are the abuse/cost guard:
# a maliciously-large or pathologically-structured repo cannot exhaust disk or
# burn unbounded embedding cost. SSRF + path-confinement are enforced in code
# (private/loopback hosts refused; clone lands under <workspace>/clones/<slug>).
GIT_CLONE_ENABLED=false
GIT_CLONE_MAX_FILES=200                  # hard ceiling on code files walked per clone
GIT_CLONE_MAX_FILE_BYTES=262144          # a single larger file is skipped (256 KiB)
GIT_CLONE_MAX_TOTAL_BYTES=20971520       # walk stops once cumulative size exceeds this (20 MiB)
GIT_CLONE_MAX_CHUNKS=300                 # hard ceiling on embedded+stored symbol chunks (bounds embedding calls)
GIT_CLONE_CLONE_TIMEOUT_S=120            # wall-clock seconds before the git clone subprocess is killed

# ── LATS / MCTS tree-search execution primitive (Phase 5 G3a; default OFF) ──
# A reasoning-space MCTS that, on a stalled CRITICAL decision, explores
# alternative next-steps via gateway-only rollouts + an LLM value function
# (UCB1 lookahead), then commits the best branch for the single-trajectory
# execute node to run. Faithful LATS but side-effect-safe (rollouts never call
# real tools) and checkpoint-safe (a fresh per-call tree; no new state field).
# Until LATS_ENABLED=true, route_after_reflect never routes to lats_search and a
# run is byte-identical to pre-G3a. Any error (gateway, budget, parse) ⇒ the
# incumbent step runs unchanged (LATS can never break a run). The caps bound the
# per-CRITICAL-retry cost: ~1 expand call + up to LATS_MAX_EVALUATIONS value
# calls (+ rollouts when LATS_ROLLOUT_DEPTH>0); the gateway budget hard-stop is
# the global backstop.
LATS_ENABLED=false
LATS_MAX_EXPANSIONS=3                    # distinct alternative next-steps proposed per search (+ the incumbent)
LATS_ROLLOUT_DEPTH=1                     # per-child imagined-rollout depth (0 = skip rollouts; flat 1-ply value pick)
LATS_MAX_EVALUATIONS=8                   # hard ceiling on value-function calls across the whole per-call tree
LATS_MAX_DEPTH=2                         # max MCTS search depth (plies); caps any deeper expansion
LATS_EXPLORATION=1.41                    # UCB1 exploration constant c (sqrt(2))
LATS_SCOPE=stall                         # stall = CRITICAL + LOW/VERY_LOW confidence only; always = any CRITICAL retry

# ── AFlow / ADAS workflow-topology optimization (Phase 5 G3b; default OFF) ──
# An OFFLINE optimizer that learns which prompting TECHNIQUES get wired into
# each graph node, in what order, PER TASK CATEGORY — the one rewirable topology
# surface (TechniqueSelector), a distinct axis from C2's single-node prompt-text
# optimizer and the mutation engine. Over a (node, category) it baseline→propose→
# evaluate→keep-if-better against an injected fitness run_fn (full agent runs
# reading correctness), then installs the winner via an AflowPolicyStore pointer
# (mirrors PromotionGate). category = inferred goal_pattern (math/reasoning/code/
# research/writing/verification/analysis) or "general". Until AFLOW_ENABLED=true
# the builder hook short-circuits BEFORE any pointer read and optimize() is a
# no-op, so technique selection is byte-identical to pre-G3b. The optimizer NEVER
# raises (structured AflowResult); the C1 capability-curve gate can refuse it,
# and a category that doesn't beat its baseline simply promotes nothing (the
# runtime hook stays unchanged) — AFlow can never regress a run. Fitness cost is
# bounded by AFLOW_MAX_CANDIDATES (× seed count) per (node, category); the
# per-run budget hard-stop inside execute_run is the global backstop.
AFLOW_ENABLED=false
AFLOW_TARGET_NODES=execute               # comma-separated nodes to optimize (e.g. "execute" or "plan,execute")
AFLOW_MAX_CANDIDATES=3                   # distinct candidate technique-policies proposed per (node, category) (dominant cost lever)
AFLOW_IMPROVEMENT_MARGIN=0.0             # required improvement over baseline to accept a policy; 0.0 = any improvement
AFLOW_MAX_COST_USD=1.0                   # advisory mid-search spend cap (0 = inert; max_candidates + per-run hard-stop are the hard bounds)
AFLOW_PREFLIGHT_CURVE_CLEAR=true         # refuse to consolidate during a known regression / insufficient curve data (C1 gate)

# ── Experimental reasoning techniques (Phase 2 #18; default OFF) ──
# Five research reasoning frameworks surfaced as selectable prompting BODIES in
# the TechniqueSelector registry, each behind its own flag (master + per-technique).
# Until EXPERIMENTAL_TECHNIQUES_ENABLED=true the registry is byte-identical to the
# curated base (the modules are imported lazily and only when a flag is on), so a
# host run never changes selection unless explicitly opted in. A flag injects ONLY
# the prompting body into node prompts; the full multi-turn controller for each
# technique is deferred (raises TechniqueDeferredError if its apply() is invoked).
# Bodies: Self-Debugging (generate→execute→debug→fix), Gödel-Agent (self-referential
# strategy rewrite), WebDreamer (world-model lookahead over actions), Absolute-Zero
# (proposer↔solver↔verifier self-play), Adversarial-Debate (proponent↔critic↔judge).
EXPERIMENTAL_TECHNIQUES_ENABLED=false
EXPERIMENTAL_TECHNIQUES_SELF_DEBUGGING_ENABLED=false
EXPERIMENTAL_TECHNIQUES_GODEL_AGENT_ENABLED=false
EXPERIMENTAL_TECHNIQUES_WEB_DREAMER_ENABLED=false
EXPERIMENTAL_TECHNIQUES_ABSOLUTE_ZERO_ENABLED=false
EXPERIMENTAL_TECHNIQUES_ADVERSARIAL_DEBATE_ENABLED=false

# ── Lean 4 formal-verification builtin (Phase 2 #17; default OFF) ──
# An opt-in builtin (lean4_runner) that type-checks Lean 4 code against the host's
# local Lean toolchain (the 'lean' binary, probed via PATH) — a formal-verification
# substrate for goals that demand machine-checked proofs. Until LEAN4_ENABLED=true
# the handler is a no-op returning a DISABLED: message (mirrors git_clone); when
# enabled but 'lean' is absent it degrades to a toolchain-absent DISABLED: message.
# The check writes the code to a confined TemporaryDirectory and runs 'lean' under
# a hard LEAN4_TIMEOUT_S ceiling. NOTE: Lean tactics/meta-programs execute during
# elaboration, so this is a code-execution trust equivalent to code_executor —
# enable only on a host/runner you trust to run agent code.
LEAN4_ENABLED=false
LEAN4_TIMEOUT_S=120                       # hard ceiling (seconds) on a single 'lean' type-check

# ── Neo4j entity/relation graph — structured mirror (Phase 5 I3; default OFF) ──
# An ADDITIVE graph store: when GRAPH_ENABLED, the MemoryManager write hooks mirror
# STRUCTURED records (sub-agent defs, skills/procedures/workflows, facts) into Neo4j
# nodes/edges on write — a relationship substrate the relational + pgvector stores
# don't express (which skills depend on X, which sub-agent handles Y). Pure structured
# sync — NO LLM extraction. Best-effort + non-fatal: a missing driver, an unreachable
# Neo4j, or any driver error is caught + logged WARNING and NEVER re-raises — a graph
# hiccup can never abort a run. Until GRAPH_ENABLED=true nothing syncs (byte-identical
# to pre-I3). Bring up the profile-gated container with: docker compose --profile graph up -d neo4j
GRAPH_ENABLED=false
NEO4J_URI=bolt://neo4j:7687              # compose internal hostname (api/worker ↔ neo4j service); host-mode runs use bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=turing-graph              # MUST match the container NEO4J_AUTH password (default neo4j/turing-graph)
NEO4J_AUTH=neo4j/turing-graph            # compose neo4j service only — user/password it bootstraps; the password part MUST equal NEO4J_PASSWORD

