# Turing Agent — environment template.
#
# Copy to .env and fill in values:
#   cp env.example .env
# Owners maintaining the committed .env.example may also: cp env.example .env.example
#
# Data stack (docker compose): PostgreSQL 18 (pgvector) on host port 5433, Redis 7
# on host port 6380. The DATABASE_URL / REDIS_URL below point at those ports. The
# non-default host ports avoid clashing with a host-local Postgres/Redis other
# apps may own on 5432/6379.

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider API Keys
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT models, embeddings)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# DeepSeek
DEEPSEEK_API_KEY=

# Zhipu AI / GLM models
ZAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_ORG_ID=

# Moonshot / Kimi
MOONSHOT_API_KEY=

# Alibaba DashScope / Qwen
# DashScope keys are region-bound. The gateway defaults to the INTERNATIONAL
# (Bailian) OpenAI-compatible endpoint, so an intl key needs no override.
# Set ALIBABA_API_BASE ONLY for a China-region key:
# ALIBABA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=

# OpenRouter
OPENROUTER_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# NVIDIA
NVIDIA_API_KEY=nvapi-

# ═══════════════════════════════════════════════════════════════════════════════
# Default Model Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash

FAST_LLM_PROVIDER=openai
FAST_LLM_MODEL=gpt-4o-mini-2024-07-18

REASONING_LLM_PROVIDER=anthropic
REASONING_LLM_MODEL=claude-sonnet-4-6

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding Configuration
# EMBEDDING_DIM MUST match the pgvector Vector(N) columns (768).
# ═══════════════════════════════════════════════════════════════════════════════

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5433/turing_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6380/0
REDIS_TTL_HOT_MEMORY=86400
REDIS_TTL_SESSION=3600
REDIS_TTL_RATE_LIMIT=60
CACHE_TTL_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Token Budget Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DAILY_TOKEN_BUDGET=500000
PER_TASK_TOKEN_LIMIT=100000
MAX_COST_USD=10.0
BUDGET_WARN_THRESHOLD=0.70
BUDGET_CRITICAL_THRESHOLD=0.90

# ═══════════════════════════════════════════════════════════════════════════════
# Evolution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

EVOLUTION_ENABLED=true
EVOLUTION_INTERVAL=10
EVOLUTION_MAX_MUTATIONS=5
EVOLUTION_SANDBOX_TIMEOUT=30
EVOLUTION_REQUIRE_HUMAN_APPROVAL=true
EVOLUTION_SANDBOX_MEMORY_MB=256
EVOLUTION_SANDBOX_IMAGE=python:3.12-slim
EVOLUTION_SANDBOX_MODE=docker
EVOLUTION_SHADOW_REPO_PATH=.turing/evolution-repo
EVOLUTION_SOURCE_DIR=src

# ═══════════════════════════════════════════════════════════════════════════════
# Agent Execution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

MAX_ITERATIONS=40
MAX_TOOLS_PER_RUN=8
MAX_SUB_AGENTS_PER_RUN=5
# Model used to generate dynamic tool-handler code. Default deepseek-v4-pro is a
# code-strong, low-cost model with a full fallback chain — avoids the CHEAP-tier
# (complexity=SIMPLE → Haiku) truncation that sank non-trivial tools. Alt:
# gpt-4.1-mini-2025-04-14. Empty → fall back to complexity=SIMPLE routing.
TOOL_GENERATION_MODEL=deepseek-v4-pro
CONTEXT_WINDOW_RESERVE=0.15
HITL_ENABLED=true
WORKSPACE_ROOT=.turing/workspace

# ═══════════════════════════════════════════════════════════════════════════════
# Logging Configuration
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_DIR=./logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# ═══════════════════════════════════════════════════════════════════════════════
# Observability Configuration
# ═══════════════════════════════════════════════════════════════════════════════

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=turing-agent
OTEL_SAMPLING_RATE=0.10

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ═══════════════════════════════════════════════════════════════════════════════
# LangSmith Tracing Configuration
# ═══════════════════════════════════════════════════════════════════════════════

LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=turing-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ═══════════════════════════════════════════════════════════════════════════════
# Environment Metadata
# ═══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
DEPLOYMENT_ID=
