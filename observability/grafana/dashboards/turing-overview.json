{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Turing Agent — Overview",
  "uid": "turing-overview",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["turing-agent"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "LLM token throughput (tokens/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "pps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (token_type) (rate(llm_request_tokens_total[5m]))",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM spend rate (USD/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "currencyusd" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (provider) (rate(llm_request_cost_usd_total[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "LLM request p95 latency (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM error rate (errors/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(llm_request_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Provider prompt-cache hit-rate (read / total tokens)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(llm_prompt_cache_read_tokens_total[5m])) / clamp_min(sum(rate(llm_request_tokens_total{token_type=\"input\"}[5m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool call rate + errors (by tool)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (tool_name) (rate(tool_calls_total[5m]))",
          "legendFormat": "{{tool_name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (tool_name) (rate(tool_call_errors_total[5m]))",
          "legendFormat": "{{tool_name}} errors",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Per-node execution duration p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, node_name) (rate(graph_node_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{node_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Circuit-breaker + latency-gate transitions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (provider, state) (rate(circuit_breaker_state_transitions_total[5m]))",
          "legendFormat": "CB {{provider}} → {{state}}",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (rate(latency_gate_demotions_total[5m]))",
          "legendFormat": "latency-gate demote {{provider}}",
          "refId": "B"
        }
      ]
    }
  ]
}
