# Turing Agent — environment template.
#
# Copy to .env and fill in values:
#   cp env.example .env
# Owners maintaining the committed .env.example may also: cp env.example .env.example
#
# Data stack (docker compose): PostgreSQL 18 (pgvector) on host port 5433, Redis 7
# on host port 6380. The DATABASE_URL / REDIS_URL below point at those ports. The
# non-default host ports avoid clashing with a host-local Postgres/Redis other
# apps may own on 5432/6379.

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Provider API Keys
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT models, embeddings)
OPENAI_API_KEY=
OPENAI_ORG_ID=

# DeepSeek
DEEPSEEK_API_KEY=

# Zhipu AI / GLM models
ZAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_ORG_ID=

# Moonshot / Kimi
MOONSHOT_API_KEY=

# Alibaba DashScope / Qwen
# DashScope keys are region-bound. The gateway defaults to the INTERNATIONAL
# (Bailian) OpenAI-compatible endpoint, so an intl key needs no override.
# Set ALIBABA_API_BASE ONLY for a China-region key:
# ALIBABA_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
ALIBABA_WORKSPACE_ID=

# OpenRouter
OPENROUTER_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# NVIDIA
NVIDIA_API_KEY=nvapi-

# ═══════════════════════════════════════════════════════════════════════════════
# SEARCH Stack (Phase 1): SearXNG primary + Meilisearch corpus + paid fallback
# ═══════════════════════════════════════════════════════════════════════════════
# SearXNG is the primary keyless live-search service; Meilisearch is the corpus
# keyword/hybrid index. Both listen on their canonical ports INSIDE the
# container (SearXNG 8080, Meilisearch 7700); docker-compose maps them to
# non-default HOST ports (8081 / 7701) so this stack never clashes with
# SearXNG/Meilisearch containers other projects may run on the defaults. The
# lightweight paid providers below are tried IN ORDER as automatic fallback when
# SearXNG fails/throttles (each used only if its key is set). Heavy providers
# (Firecrawl/Apify) are PROVISIONED-ONLY — they stay off unless
# DEEP_CRAWL_ENABLED=true.
#
# Primary + corpus service endpoints. Host-run values point at the mapped host
# ports (8081/7701); compose overrides these to the in-container hostnames
# http://searxng:8080 and http://meilisearch:7700 for the agent container.
SEARCH_PRIMARY=searxng
SEARXNG_URL=http://localhost:8081
SEARXNG_TIMEOUT=10
SEARXNG_MAX_RESULTS_PER_QUERY=10
MEILISEARCH_URL=http://localhost:7701
# Meilisearch master key. Leave EMPTY for keyless dev (MEILI_ENV=development runs
# without auth, which an empty key here matches). For production set a key of at
# least 16 bytes — the SAME value must be used by the agent (here) and by the
# compose service (docker-compose.yml MEILI_MASTER_KEY reads this var).
MEILISEARCH_KEY=
MEILISEARCH_INDEX=turing_corpus
MEILISEARCH_TIMEOUT=10
# Meilisearch indexes documents asynchronously: POST /documents returns a taskUid
# whose completion is polled (GET /tasks/{uid}) so an index-then-search in the
# same coroutine sees the docs (S11). interval: poll cadence; max_polls: cap
# (~3s @ 0.1s×30) after which we proceed — search may lag one beat.
MEILISEARCH_TASK_POLL_INTERVAL=0.1
MEILISEARCH_TASK_MAX_POLLS=30

# Comma-separated lightweight providers tried after SearXNG (in order).
SEARCH_FALLBACK_PROVIDERS=tavily,serper,brave,serpapi,serpstack,llmlayer

# Batch/parallel fan-out for web_search(queries) + corpus_search(queries).
SEARCH_BATCH_CONCURRENCY=5

# AI-format extraction/chunking (web_scraper -> corpus index).
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Heavy providers (Firecrawl/Apify): provisioned below but OFF by default.
DEEP_CRAWL_ENABLED=false

# ── Lightweight paid fallback provider keys (auto-fallback, optional) ──
TAVILY_API_KEY=
# Tavily adapter tuning (S12). Tavily returns a per-hit relevance score (0..1);
# these shape its request + result filter. Defaults keep the cheap/broad path.
#   search_depth: basic (cheaper) | advanced (higher quality, more credits)
#   topic: general | news  (days is only sent when topic=news)
#   include/exclude_domains: comma-separated hostnames, e.g. "arxiv.org,ncbi.nlm.nih.gov"
#   min_score: drop hits with score below this (0.0 = keep all)
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_DAYS=3
TAVILY_INCLUDE_DOMAINS=
TAVILY_EXCLUDE_DOMAINS=
TAVILY_MIN_SCORE=0.0
SERPER_API_KEY=
SERPAPI_API_KEY=
LLMLAYER_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPSTACK_API_KEY=

# ── Heavy providers (provisioned-only; need DEEP_CRAWL_ENABLED=true to engage) ──
APIFY_API_KEY=
FIRECRAWL_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Default Model Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash

FAST_LLM_PROVIDER=openai
FAST_LLM_MODEL=gpt-4o-mini-2024-07-18

# Z.AI GLM-4.7 (Moderate, 128K ctx, Text+Image) is the reasoning model. Swapped
# from claude-sonnet-4-6 (Anthropic) after that key hit an account usage cap
# (blocked until 2026-07-01). glm-4.7 is the registered MODERATE-tier Z.AI peer
# to Sonnet; verified live (zai/glm-4.7). Sonnet stays registered as a deep
# fallback — re-promote once the Anthropic quota resets.
REASONING_LLM_PROVIDER=zai
REASONING_LLM_MODEL=glm-4.7
# REASONING_LLM_PROVIDER=anthropic
# REASONING_LLM_MODEL=claude-sonnet-4-6

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Resilience, Circuit Breaker & Rate Limiting
# Operator-tunable knobs for the litellm gateway: retry/backoff, default sampling
# temperature + max_tokens (used when a call site omits them), the per-provider
# circuit breaker, and the default per-provider RPM/TPM token buckets.
# ═══════════════════════════════════════════════════════════════════════════════

LLM_MAX_RETRIES=3
LLM_RETRY_INITIAL_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0
LLM_RETRY_JITTER=2.0
LLM_DEFAULT_TEMPERATURE=0.5
LLM_DEFAULT_MAX_TOKENS=4096

# Per-call LLM timeout (seconds) passed to litellm. Without it litellm defaults to
# ~600s, so one unresponsive provider stalls the whole run. Bounded by LLM_MAX_RETRIES:
# worst case ≈ timeout × retries before the fallback chain takes over.
REQUEST_TIMEOUT=90
# Longer timeout for code-generation calls (tool_create + evolution CODE mutations)
# that emit a full handler in one shot — these legitimately exceed REQUEST_TIMEOUT
# (observed live: a 58s deepseek-v4-pro codegen call cut at the old 60s default).
# Passed via a per-call override so reasoning/embedding calls keep REQUEST_TIMEOUT.
CODEGEN_TIMEOUT=180

# Tuned down from 5: rate-limit storms spread transient failures across providers,
# so 5-on-one rarely accumulates and the breaker's OPEN path never engaged.
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=60.0
CB_HALF_OPEN_MAX_CALLS=1

RATE_LIMIT_DEFAULT_RPM=60
RATE_LIMIT_DEFAULT_TPM=100000

# Provider-native prompt caching (Anthropic cache_control). When enabled, a
# long system message sent to an Anthropic model is tagged with an ephemeral
# cache_control breakpoint so the reused system prompt is served from the
# provider cache on subsequent calls. Off by default → zero behavior change.
PROMPT_CACHE_CONTROL_ENABLED=false
PROMPT_CACHE_CONTROL_MIN_SYSTEM_TOKENS=1024

# Concurrent request batching for LLMGateway.abatch. Many independent
# completions run via asyncio.gather bounded by max_concurrency; the per-
# provider rate limiter still gates RPM/TPM under each call. Off by default →
# when disabled, abatch runs sequentially (concurrency 1).
LLM_BATCH_ENABLED=false
LLM_BATCH_MAX_CONCURRENCY=5

# Per-tier extended thinking/reasoning. When enabled, complex/critical tasks get
# provider-native thinking (Anthropic `thinking`, DeepSeek/Z.AI `extra_body`,
# OpenAI o-series `reasoning_effort`) and trivial/simple tasks get it off. Off
# by default → no thinking params emitted (zero behavior change). Anthropic
# requires temperature=1.0 with thinking; enforced automatically when enabled.
REASONING_CONTROL_ENABLED=false
REASONING_CONTROL_COMPLEX_THINKING=medium
REASONING_CONTROL_SIMPLE_THINKING=none
REASONING_CONTROL_ANTHROPIC_BUDGET_TOKENS_COMPLEX=8000
REASONING_CONTROL_ANTHROPIC_BUDGET_TOKENS_MEDIUM=4000

# Native JSON-schema structured outputs. When enabled, acompletion(response_schema=...)
# converts the JSON schema to a provider-native response_format (OpenAI/DeepSeek
# strict json_schema, Anthropic output_format, Gemini response_schema) so the
# model emits schema-conformant JSON natively. Off by default → response_schema
# is ignored (back-compat with prompt-based JSON + json_repair).
NATIVE_STRUCTURED_OUTPUT_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding Configuration
# EMBEDDING_DIM MUST match the pgvector Vector(N) columns (768).
# ═══════════════════════════════════════════════════════════════════════════════

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5433/turing_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6380/0
REDIS_TTL_HOT_MEMORY=86400
REDIS_TTL_SESSION=3600
REDIS_TTL_RATE_LIMIT=60
CACHE_TTL_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════════════
# Token Budget Configuration
# ═══════════════════════════════════════════════════════════════════════════════

DAILY_TOKEN_BUDGET=500000
# Per-run cumulative token cap (raised 100K→200K: a legitimately-large COMPLEX
# run routinely exceeds 100K before converging; the old default downgraded it
# prematurely). The gateway downgrades-on-exhaust at this cap by default.
PER_TASK_TOKEN_LIMIT=200000
MAX_COST_USD=10.0
BUDGET_WARN_THRESHOLD=0.70
BUDGET_CRITICAL_THRESHOLD=0.90
# Opt-in budget HARD-stop (battery-04 q09 fix D). Default off (downgrade). When
# true, exhausting the per-run cap RAISES BudgetExhaustedError → the run stops,
# is marked BUDGET_EXHAUSTED (resumable via --resume), instead of silently
# downgrading onto a free-tier provider and fabricating under degradation.
BUDGET_HARD_STOP=false

# ═══════════════════════════════════════════════════════════════════════════════
# Evolution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

EVOLUTION_ENABLED=true
EVOLUTION_INTERVAL=10
EVOLUTION_MAX_MUTATIONS=5
EVOLUTION_SANDBOX_TIMEOUT=30
EVOLUTION_REQUIRE_HUMAN_APPROVAL=true
EVOLUTION_SANDBOX_MEMORY_MB=256
EVOLUTION_SANDBOX_IMAGE=python:3.12-slim
# Mode for executing evolution-mutated code: docker | subprocess | runner.
#   docker     — isolated self-evolving-agent-toolbox container (needs a Docker socket).
#   runner     — remote no-DinD runner container over HTTP (Phase 3b/c: no
#                socket on the worker, no DB creds, no egress). The docker-compose
#                stack FORCES runner for the worker role (overrides this value).
#   subprocess — host subprocess fallback (no isolation).
EVOLUTION_SANDBOX_MODE=docker
EVOLUTION_SHADOW_REPO_PATH=.turing/evolution-repo
EVOLUTION_SOURCE_DIR=src
# Heuristic config-tuning mutation proposed temperature + max-tokens factor.
EVOLUTION_TEMPERATURE=0.4
EVOLUTION_MAX_TOKENS_FACTOR=0.9
# Subprocess-sandbox venv-create / package-install timeouts (seconds) for the
# dynamic-tool codegen validation path.
SANDBOX_VENV_CREATE_TIMEOUT=60
SANDBOX_PACKAGE_INSTALL_TIMEOUT=120
# Phase 8 — evolution→live promotion gate (opt-in). When true, a deployed PROMPT
# mutation that passes the eval canary (>= EVAL_CANARY_MIN_SCORE) is written as a
# versioned artifact under EVOLVED_HANDLERS_DIR and a `current` pointer is updated
# so the live agent loads it via the prompt builder (tagged [evolved]). Scoped to
# PROMPT mutations (CODE/TOOL already reach live via the DB tool registry). Off by
# default — nothing promotes until the operator opts in.
EVOLUTION_PROMOTE_TO_LIVE=true
# Directory holding promoted, versioned handler artifacts (prompts first):
# <dir>/prompts/<node>.<sha>.json (immutable versions) + current.json (live
# pointer). Default under .turing/ (gitignored scratch), NOT in core src/.
EVOLVED_HANDLERS_DIR=.turing/evolved

# ═══════════════════════════════════════════════════════════════════════════════
# Agent Execution Configuration
# ═══════════════════════════════════════════════════════════════════════════════

MAX_ITERATIONS=60
# Complexity-aware runtime iteration cap (B1). When a run does NOT pin an
# explicit cap (no --max-iterations / worker max_iterations / eval spec), the
# routers + error_handler terminate at the tier cap for the classified goal
# complexity: a TRIVIAL goal stops loop-hunting early, COMPLEX/CRITICAL keep
# headroom. MAX_ITERATIONS above stays the recursion_limit BASIS and must be >=
# max(MAX_ITERATIONS_COMPLEX, MAX_ITERATIONS_CRITICAL) (validated at startup).
MAX_ITERATIONS_TRIVIAL=12
MAX_ITERATIONS_SIMPLE=15
MAX_ITERATIONS_COMPLEX=60
MAX_ITERATIONS_CRITICAL=60
# Convergence early-exit (B3): if verify produces an identical output
# fingerprint across this many consecutive passes AND the plan is exhausted,
# route_after_verify accepts the partial result via store_memory instead of
# looping to the iteration hard-cap (the run is "stably stuck"). Default 3:
# one transient repeat is common; three unchanged passes is a real plateau.
CONVERGENCE_STABLE_THRESHOLD=3
# Capability-cap gap-loop break (battery-04 q09 fix B). After this many
# consecutive cap-blocked spawn/create node-visits with no new capability
# (caps saturated), the routers stop re-routing into spawn/create and route to
# plan/verify instead, forcing convergence (resets to 0 on any real progress).
# Default 2 = one fully-saturated spawn+create cycle; live-validated on q09
# (3 needs 1.5 cycles, which a slow model never reaches inside the timeout).
CAP_LOOP_BREAK_THRESHOLD=2
MAX_TOOLS_PER_RUN=12
MAX_SUB_AGENTS_PER_RUN=5
# Execute-node concurrency + write-nudge loop, tool-gen regeneration attempts,
# and the verify-node data-tool ground-truth cap.
MAX_CONCURRENT_TOOLS=5
MAX_WRITE_NUDGES=2
TOOL_GEN_MAX_ATTEMPTS=3
VERIFY_MAX_DATA_TOOLS=8
# F2: bounded retry count for framework-mandated tool DB-persistence. Each
# attempt opens a fresh DB session so a transient connection error recovers.
TOOL_PERSIST_MAX_ATTEMPTS=2
# M4: per-tool success-metrics recording + performance retirement. Recording
# times every tool invocation and stores success/empty/latency (tool_call_metrics
# detail + running aggregates on tool_registrations). Non-fatal: a DB hiccup in
# the recorder never breaks a run. On load, chronic low performers are retired:
# calls >= RETIRE_MIN_RUNS and success_rate < RETIRE_SUCCESS_FLOOR. RETIRE_* also
# bound the over-cap path; MAX_ACTIVE_TOOLS is the hard population cap.
TOOL_METRICS_ENABLED=true
RETIRE_MIN_RUNS=20
RETIRE_SUCCESS_FLOOR=0.25
RETIRE_RECENCY_DAYS=30
# Ambiguity-resolution cascade (Feature B; all default-off). When the master
# gate is on, classify flags an ambiguous goal (severity >= threshold) routes
# classify -> disambiguate -> plan. The disambiguate node runs a graduated
# ladder — LLM self-resolve -> web_search grounding -> LLM re-score -> HITL
# last resort — and carries the resolution forward as ADVISORY planner context
# (the literal goal is NEVER replaced; it stays the OBJECTIVE). With the gate
# off (default) route_after_classify always returns "plan" and the topology is
# byte-identical to today. Web grounding is on WITHIN the gate by default;
# HITL degrades to advisory (no Command(resume=) resume surface in worker/CLI
# today) rather than stalling the run.
CLARIFYING_GATE_ENABLED=false
CLARIFYING_SEVERITY_THRESHOLD=0.5
CLARIFYING_WEB_GROUNDING_ENABLED=true
CLARIFYING_MAX_QUERIES=3
CLARIFYING_HITL_THRESHOLD=0.7
CLARIFYING_HITL_ENABLED=false
# Per-step atomicity (Feature C; default-off). plan_quality is ALWAYS computed
# and attached as advisory telemetry (flags each step atomic / too_coarse /
# too_fine). When this gate is on, a too_coarse step (>=2 conjunctions) triggers
# ONE bounded heuristic conjunction-split (guarded so a reflect->plan loop can't
# re-split forever). Pure heuristic — zero LLM cost. Default off: plans pass
# through unchanged.
PLAN_ATOMICITY_ENFORCE=false
# Feature E: persist classify's refined_intent (Feature A) as a durable
# semantic fact (memory_type="fact") so later runs recall the real desired
# outcome behind a recurring goal. Best-effort + non-fatal. Default off.
PERSIST_INTENT_FACTS=false
# Autonomous memory-folding LLM sampling temperature + output budget.
MEMORY_FOLDING_TEMPERATURE=0.1
MEMORY_FOLDING_MAX_TOKENS=2048
# Phase 5 semantic/fact memory tier. On each persisted fold the episode summary
# is mined for durable facts (entity-ish knowledge: schemas/counts/invariants)
# and stored as warm memory_type="fact" — distinct from skills and from episodic
# cold memory, recalled alongside skills. Extraction is best-effort (a gateway
# failure yields no facts, never an error). MEMORY_FACT_MAX_PER_FOLD bounds how
# many facts a single fold can emit.
MEMORY_FACT_EXTRACTION_ENABLED=true
MEMORY_FACT_MAX_PER_FOLD=5
# A4: how many recent hot-memory observations retrieve_context surfaces,
# newest-first (Redis ZSET recency index). Replaces the legacy unordered
# scan that hard-capped at 2.
MEMORY_HOT_RECALL_SIZE=3
# Phase 3 evaluation harness (correctness layer). EVAL_ENABLED gates the
# verify-node correctness checks — a normal goal with no registered GoalSpec is
# unaffected even when true; set true (or use `python main.py --eval`) to score
# Battery-04 goals. EVAL_ENFORCE (enabled here; code default false) downgrades a
# "complete" verdict to incomplete when a correctness check fails so the agent
# retries + self-corrects. The LLM
# judge (deepeval/ragas with a gateway fallback) and the durable eval_results
# store have their own toggles; EVAL_CANARY_MIN_SCORE gates oracle pass/fail.
EVAL_ENABLED=true
EVAL_ENFORCE=true
EVAL_LLM_JUDGE_ENABLED=true
EVAL_CANARY_MIN_SCORE=0.8
EVAL_STORE_ENABLED=true
# F-e: run correctness checks the first time deliverables appear on disk on an
# INCOMPLETE verify (not just at is_complete), folding failing-check reasons
# into the re-plan as advisory feedback. Bounded to one rescue per run.
EVAL_RESCUE_INCOMPLETE=true
# Model used to generate dynamic tool-handler code. Default deepseek-v4-pro is a
# code-strong, low-cost model with a full fallback chain — avoids the CHEAP-tier
# (complexity=SIMPLE → Haiku) truncation that sank non-trivial tools. Alt:
# gpt-4.1-mini-2025-04-14. Empty → fall back to complexity=SIMPLE routing.
TOOL_GENERATION_MODEL=deepseek-v4-pro
CONTEXT_WINDOW_RESERVE=0.15
HITL_ENABLED=true
WORKSPACE_ROOT=.turing/workspace
# Phase 7: per-run results subfolders. When true + a run_id active (set by
# --run-id), deliverables written via the shared path resolver land under
# results_root/<run_id>/... (isolating each run). Reads fall back to the flat
# results_root when the run subdir is empty, so older flat deliverables still
# recall. CLI flags --results-dir <path> and --clean also govern this. No-op
# without a run_id. RESULTS_ROOT itself defaults to "results".
RESULTS_ROOT=results
RESULTS_PER_RUN_SUBDIR=true

# ═══════════════════════════════════════════════════════════════════════════════
# Built-in Tool Limits (timeouts, size caps, retry params)
# Bound tool I/O. Read at call-time so .env changes take effect without a
# restart in long-running hosts.
# ═══════════════════════════════════════════════════════════════════════════════

# terminal_command
TERMINAL_COMMAND_TIMEOUT=30.0
TERMINAL_MAX_OUTPUT_BYTES=16000
# http_request
HTTP_REQUEST_TIMEOUT=15.0
HTTP_MAX_RESPONSE_CHARS=8000
HTTP_MAX_BODY_BYTES=1000000
# web_scraper
WEB_SCRAPER_TIMEOUT=20.0
WEB_SCRAPER_MAX_BYTES=5242880
WEB_SCRAPER_MAX_CHARS=8000
# code_executor
CODE_EXECUTOR_TIMEOUT=30
# ── code_executor sandbox isolation (Phase 2c docker / Phase 3b/c runner) ──
#   subprocess — host subprocess (default; no isolation). The host-run default.
#   docker     — isolated self-evolving-agent-toolbox container (network off, read-only FS,
#                memory cap), results dir mounted RW. Needs a Docker socket +
#                `docker compose --profile sandbox build toolbox`. Falls back to
#                the host subprocess if Docker is unavailable.
#   runner     — remote no-DinD runner container over HTTP (Phase 3b/c: no socket
#                on the worker, no DB creds, no egress). The docker-compose stack
#                FORCES runner for the worker role (overrides this value); for a
#                host `python main.py` run, set MODE=runner + RUNNER_URL to a
#                runner you have started separately.
CODE_EXECUTOR_MODE=subprocess
CODE_EXECUTOR_SANDBOX_IMAGE=self-evolving-agent-toolbox:latest
CODE_EXECUTOR_SANDBOX_MEMORY_MB=512
CODE_EXECUTOR_SANDBOX_TIMEOUT=60
CODE_EXECUTOR_RESULTS_MOUNT=
CODE_EXECUTOR_SANDBOX_WORKDIR_DEST=/workspace/results
# ── remote no-DinD runner client (Phase 3b/c) ──
# Where the worker POSTs code in runner mode. The compose stack sets this to
# http://runner:8090 (internal). For a host run, point it at a standalone runner.
# Connect/5xx/malformed errors raise SandboxUnavailable -> code_executor falls
# back to the host subprocess so a run never hard-fails on a down runner.
RUNNER_URL=http://runner:8090
RUNNER_CONNECT_TIMEOUT_S=5.0
RUNNER_MAX_TIMEOUT_S=300
# web_search (DuckDuckGo)
WEB_SEARCH_MAX_ATTEMPTS=3
WEB_SEARCH_DELAY_MIN=0.2
WEB_SEARCH_DELAY_MAX=0.6

# ═══════════════════════════════════════════════════════════════════════════════
# Logging Configuration
# ═══════════════════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FORMAT=structured
LOG_DIR=./logs
LOG_ROTATION=00:00
LOG_RETENTION=30 days

# ═══════════════════════════════════════════════════════════════════════════════
# Observability Configuration
# ═══════════════════════════════════════════════════════════════════════════════

OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=turing-agent
OTEL_SAMPLING_RATE=0.10

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ═══════════════════════════════════════════════════════════════════════════════
# LangSmith Tracing Configuration
# ═══════════════════════════════════════════════════════════════════════════════

LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=turing-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ═══════════════════════════════════════════════════════════════════════════════
# Environment Metadata
# ═══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=development
DEPLOYMENT_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# Worker — Redis Streams queue seam (Phase 2b)
# ═══════════════════════════════════════════════════════════════════════════════

# The stateless API role enqueues run requests to a Redis Stream; worker
# processes consume them via a consumer group. At-least-once delivery: a worker
# XACKs only AFTER the run's checkpoint is durable, so a crash between claim and
# ack leaves the message pending for another worker to reclaim (XAUTOCLAIM) and
# resume from the last checkpoint (thread_id = api-{run_id} is stable). See
# src/worker/.

WORKER_RUNS_STREAM=turing:runs
WORKER_GROUP=turing-workers
# LEAVE UNSET for a replicated worker pool: each replica then auto-derives a
# UNIQUE consumer name (worker-<hostname>-<pid>) so replicas don't share a
# pending-entries list — XAUTOCLAIM crash-recovery stays sound at scale. Setting
# a fixed name here (e.g. worker-1) makes EVERY replica collide on that one name,
# silently breaking crash-recovery (the exact bug this default shipped for years).
# Set an explicit value ONLY for a single, fixed-name worker (debugging).
# WORKER_CONSUMER_NAME=worker-1
WORKER_READ_BATCH_SIZE=5
WORKER_BLOCK_MS=5000
WORKER_RECLAIM_MIN_IDLE_MS=30000
WORKER_STATUS_TTL_S=86400
# Dead-letter cap: after this many failed delivery attempts a run is acked +
# marked FAILED permanently (NOT redelivered). Stops infinite poison-message
# redelivery of a DETERMINISTIC failure (e.g. a missing dep crashing graph build)
# — XAUTOCLAIM would otherwise re-hand it to a worker every RECLAIM_MIN_IDLE_MS
# forever. Transient failures still retry up to this many times.
WORKER_DEAD_LETTER_MAX_ATTEMPTS=3
# Run-level wall-clock timeout (battery-04 q09 fix A). Default 0 = OFF. When >0
# the worker wraps execute_run in asyncio.timeout; on expiry the run is marked
# TIMEOUT + acked (terminal, not redelivered) and the checkpoint persists so it
# is resumable via `python main.py --resume <run_id>`. A per-run override is
# POST /run {run_timeout_s}. Bounds non-terminating cap-saturation loops.
WORKER_RUN_TIMEOUT_S=0

# ═══════════════════════════════════════════════════════════════════════════════
# Scheduler — nightly capability-curve battery feeder (#197 Phase 5)
# ═══════════════════════════════════════════════════════════════════════════════
#
# No run path is time-triggered today: runs enter turing:runs only via the API
# or the host CLI --eval, so the capability curve only updates when a human runs
# --eval. This sidecar (python -m src.scheduler) enqueues every BATTERY04_GOALS
# spec into turing:runs on SCHEDULER_CRON, so the worker runs the battery through
# the real deployed stack and eval_results populates the curve autonomously.
#
# Opt-in: SCHEDULER_ENABLED defaults false (a bare host run is a clean no-op).
# The docker-compose `scheduler` service is profile-gated AND forces it true.
# Bring it up with: docker compose --profile scheduler up -d
SCHEDULER_ENABLED=false
# 5-field crontab (APScheduler CronTrigger.from_crontab). Default: nightly 02:00.
SCHEDULER_CRON=0 2 * * *
# IANA timezone for the cron schedule.
SCHEDULER_TIMEZONE=UTC
# Optional pinned model for every battery run (registry key / litellm id). Empty
# -> each run uses its complexity-tiered default.
SCHEDULER_MODEL=
# Battery runs SHOULD exercise evolution (the richest learning signal). Set true
# only to disable evolution for a scheduled battery (debugging / baseline).
SCHEDULER_NO_EVOLUTION=false
# Smoke / partial-curve cap: 0 = enqueue EVERY spec (the production nightly curve);
# >0 = enqueue only the first N (set 1 for a cheap one-spec plumbing smoke that
# does not run the full battery).
SCHEDULER_SPEC_LIMIT=0
# strftime appended to each spec id as -<suffix> for per-night results isolation.
# Keep %Y%m%d (compact, no embedded hyphens): _resolve_eval_spec_id strips a
# trailing -YYYYMMDD (8 digits) to recover the spec id for eval scoring.
SCHEDULER_DATE_SUFFIX_FORMAT=%Y%m%d

# ──────────────────────────────────────────────────────────────────────
# Capability-curve trend + regression→rollback gate (Phase 2 C1).
# The nightly battery collects per-check correctness scores over time in
# eval_results; this gate watches the battery TREND across nights and reverts
# a PROMPT promotion whose benefit did not hold (the single-goal canary only
# gates at promotion time). Regression = current < SCORE_FLOOR AND
# (best_prior - current) >= REGRESSION_DELTA AND >= MIN_POINTS nights. Detection
# is always-on + read-only; AUTO_ROLLBACK is the human's opt-in to automatic
# reversion (default off, like the scheduler). The gate job defaults to 05:00
# UTC (after the 02:00 battery). See src/eval/curve.py + src/evolution/curve_gate.py.
CAPABILITY_CURVE_GATE_ENABLED=false
CAPABILITY_CURVE_CURVE_CRON=0 5 * * *
CAPABILITY_CURVE_TIMEZONE=UTC
CAPABILITY_CURVE_REGRESSION_DELTA=0.1
CAPABILITY_CURVE_SCORE_FLOOR=0.5
CAPABILITY_CURVE_LOOKBACK_DAYS=30
CAPABILITY_CURVE_MIN_POINTS=2
CAPABILITY_CURVE_AUTO_ROLLBACK=false

# ═══════════════════════════════════════════════════════════════════════════════
# Periodic capability-governance prune (battery-04 q09 fix C)
# ═══════════════════════════════════════════════════════════════════════════════
# A long-lived worker accumulates the active tool/sub-agent population across
# runs and never prunes until restart (q09 saturated 25/25 tools, 60/60
# sub-agents mid-life). When enabled, the scheduler re-runs the existing
# consolidate.py retire/redundancy passes on GOVERNANCE_PRUNE_CRON, freeing cap
# headroom WITHOUT raising the caps. Reuses AgentSettings retire knobs. Opt-in.
GOVERNANCE_PRUNE_ENABLED=false
GOVERNANCE_PRUNE_CRON=0 4 * * *
GOVERNANCE_PRUNE_TIMEZONE=UTC

# ═══════════════════════════════════════════════════════════════════════════════
# Metric-driven prompt optimizer sidecar (Phase 2 C2: DSPy + GEPA)
# ═══════════════════════════════════════════════════════════════════════════════
# A nightly, cost-bounded job that runs DSPy/GEPA against the golden canary and
# — IF a candidate prompt beats the baseline correctness score by the margin AND
# C1's capability-curve regression gate is clear — pushes it through the EXISTING
# PromotionGate (canary-gated, auto-rollback). Beyond the engine's one-shot LLM
# PROMPT mutation: a real metric-driven SEARCH over prompt instructions.
#
# Runs in its OWN container (`self-evolving-agent-optimizer`, profile-gated) so
# the DSPy+GEPA ML deps stay out of the slim api/worker images. DSPy declares NO
# torch dependency (`import dspy` is torch-free; verified dspy==3.2.1). The
# sidecar imports src/, runs its own LLMGateway against the shared cost_ledger
# (cost/budget/circuit-breaker work natively), and spend lands under run_id
# `optimizer-<node>-<ts>` — bounded by OPTIMIZER_MAX_COST_USD.
#
# Architecture (GEPA's real API): GEPA optimizes a DSPy module's instruction by
# running it (1 LLM call) and scoring — it can't run the full agent graph in its
# loop. So GEPA searches candidates against a CHEAP PROXY metric (bounds cost);
# the optimized instruction is then VALIDATED against the REAL GoldenCanary
# correctness score (full agent runs) before promotion. The eval metric stays the
# promotion gate (DoD satisfied); GEPA supplies the search; C1 backstops the
# proxy→canary transfer risk.
#
# PRECONDITION: only enable once C1's regression gate (CAPABILITY_CURVE_*) is
# proven. Every knob defaults OFF. No DB migration (reuses eval_results +
# cost_ledger + .turing/evolved/prompts/).
OPTIMIZER_ENABLED=false
OPTIMIZER_BACKEND=dspy-gepa              # dspy-gepa | dspy-mipro | dspy-copro
OPTIMIZER_TARGET_NODE=classify           # v1 ships the classify profile; execute/verify are pluggable-but-unshipped
OPTIMIZER_EVAL_SPEC_LIMIT=2              # golden specs the FINAL canary validates against (cheapest=1)
OPTIMIZER_MAX_CANDIDATES=8               # MIPROv2/COPRO breadth (GEPA budget is max_trials)
OPTIMIZER_MAX_TRIALS=1                   # GEPA full-eval rounds (0 → auto="light")
OPTIMIZER_MAX_TOKENS=1024                # DSPy student + reflection LM max output tokens
OPTIMIZER_TEMPERATURE=0.7                # LM sampling temperature
OPTIMIZER_CRON="30 3 * * *"              # 03:30 UTC — between 02:00 battery and 05:00 curve-gate
OPTIMIZER_TIMEZONE=UTC
OPTIMIZER_HOST=0.0.0.0                     # aiohttp bind (internal-only on turing-net; no host port is published)
OPTIMIZER_PORT=8095                        # the sidecar's own listen port (scheduler connects via OPTIMIZER_URL)
OPTIMIZER_URL=http://optimizer:8095        # client-side connect URL the scheduler POSTs /optimize to (compose service name)
OPTIMIZER_REQUIRE_CURVE_CLEAR=true       # refuse while curve regressed/inconclusive (C1 precondition)
# OPTIMIZER_CANARY_MIN_SCORE=0.0         # uncomment + set the required (candidate−baseline) margin; blank → reuse EVAL_CANARY_MIN_SCORE as the floor
OPTIMIZER_MAX_COST_USD=0.50              # hard spend cap per optimization run (US$)

