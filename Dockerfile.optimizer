# syntax=docker/dockerfile:1
# self-evolving-agent-optimizer — the metric-driven prompt-optimizer sidecar
# (Phase 2 C2: DSPy + GEPA).
#
# Runs src/optimizer (the aiohttp server in src/optimizer/server.py): the
# scheduler POSTs /optimize nightly; PromptOptimizer runs DSPy/GEPA against a
# CHEAP proxy metric, then VALIDATES the candidate against the REAL GoldenCanary
# (full agent runs through its own LLMGateway against the shared cost_ledger) and,
# on beating the baseline, pushes the prompt through the EXISTING PromotionGate
# (canary-gated, auto-rollback). C1's capability-curve must be clear before spend.
#
# LAYERED IMAGE: `FROM self-evolving-agent:latest` reuses the app's full src/ +
# ALL its deps (litellm 1.83.14, the gateway, the canary, DB models) so src/ stays
# in sync and there is no duplicate dep list — the optimizer is "app + ML stack".
# It ADDS only the DSPy/GEPA ML deps (requirements.optimizer.txt), which carry NO
# torch. Build the base FIRST (building api/worker produces self-evolving-agent:
# latest), then:
#   docker compose --profile optimizer build optimizer
#   (or: docker build -f Dockerfile.optimizer -t self-evolving-agent-optimizer:latest .)
#
# NOT least-privilege like the runner: it runs the FULL canary (provider keys +
# DATABASE_URL via .env/compose), so it is a full agent role + ML deps, internal-
# only on turing-net (no host port published; the scheduler reaches it by name).

FROM self-evolving-agent:latest

# The base image ends USER turing (non-root); install the ML deps as root into the
# system site-packages (/usr/local, where the base's packages live) so the turing
# runtime imports them, then drop back to turing (no privilege at run time).
USER root

COPY requirements.optimizer.txt /tmp/requirements.optimizer.txt

# Install + ENFORCE the no-torch invariant at build time (the locked decision):
#   (1) dspy/gepa/litellm import cleanly;
#   (2) importing them does NOT load torch (torch not in sys.modules);
#   (3) torch is NOT importable in the image at all (fail the build if a transitive
#       dep dragged it in).
# `! python -c "import torch"` succeeds only when torch is ABSENT (import errors →
# exit 1 → `!` → 0); if torch were present the build stops here.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r /tmp/requirements.optimizer.txt \
    && python -c "import dspy, gepa, litellm, sys; assert 'torch' not in sys.modules, 'dspy/gepa pulled torch at import time'" \
    && ! python -c "import torch" \
    && python -c "import dspy, litellm; print('optimizer image deps OK: dspy', dspy.__version__, '| litellm', litellm.__version__)"

USER turing

ENV PYTHONUNBUFFERED=1

# Internal only (no host port mapping in compose). The scheduler POSTs
# http://optimizer:8095/optimize over turing-net.
EXPOSE 8095

CMD ["python", "-m", "src.optimizer"]
